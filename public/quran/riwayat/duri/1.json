[{"id":1,"text":"اِ۬لۡحَمۡدُ لِلَّهِ رَبِّ اِ۬لۡعَٰلَمِينَ"},{"id":2,"text":"اَ۬لرَّحۡمَٰنِ اِ۬لرَّحِيمِ"},{"id":3,"text":"مَلِكِ يَوۡمِ اِ۬لدِّينِ"},{"id":4,"text":"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ"},{"id":5,"text":"اُ۪هۡدِنَا اَ۬لصِّرَٰطَ اَ۬لۡمُسۡتَقِيمَ"},{"id":6,"text":"صِرَٰطَ اَ۬لَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ"},{"id":7,"text":"غَيۡرِ اِ۬لۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا اَ۬لضَّآلِّينَ"}]