[{"id":1,"text":"وَاَلضُّحۭيٰ"},{"id":2,"text":"وَاَلَّيۡلِ إِذَا سَجۭيٰ"},{"id":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلۭيٰ"},{"id":4,"text":"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ اَ۬لۡأُولۭيٰ"},{"id":5,"text":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضۭيٰٓ"},{"id":6,"text":"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوۭيٰ"},{"id":7,"text":"وَوَجَدَكَ ضَآلّٗا فَهَدۭيٰ"},{"id":8,"text":"وَوَجَدَكَ عَآئِلٗا فَأَغۡنۭيٰ"},{"id":9,"text":"فَأَمَّا اَ۬لۡيَتِيمَ فَلَا تَقۡهَرۡ"},{"id":10,"text":"وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنۡهَرۡ"},{"id":11,"text":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ"}]