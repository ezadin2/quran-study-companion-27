[{"id":1,"text":"اِ۬لرَّحۡمَٰنُ عَلَّمَ اَ۬لۡقُرۡءَانَ"},{"id":2,"text":"خَلَقَ اَ۬لۡإِنسَٰنَ عَلَّمَهُ اُ۬لۡبَيَانَ"},{"id":3,"text":"اَ۬لشَّمۡسُ وَاَلۡقَمَرُ بِحُسۡبَانٖ"},{"id":4,"text":"وَاَلنَّجۡمُ وَاَلشَّجَرُ يَسۡجُدَانِ"},{"id":5,"text":"وَاَلسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لۡمِيزَانَ"},{"id":6,"text":"أَلَّا تَطۡغَوۡاْ فِي اِ۬لۡمِيزَانِ"},{"id":7,"text":"وَأَقِيمُواْ اُ۬لۡوَزۡنَ بِالۡقِسۡطِ وَلَا تُخۡسِرُواْ اُ۬لۡمِيزَانَ"},{"id":8,"text":"وَاَلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ"},{"id":9,"text":"فِيهَا فَٰكِهَةٞ وَاَلنَّخۡلُ ذَاتُ اُ۬لۡأَكۡمَامِ"},{"id":10,"text":"وَاَلۡحَبُّ ذُو اُ۬لۡعَصۡفِ وَاَلرَّيۡحَانُ"},{"id":11,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":12,"text":"خَلَقَ اَ۬لۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَاَلۡفَخّ۪ارِ"},{"id":13,"text":"وَخَلَقَ اَ۬لۡجَآنَّ مِن مَّارِجٖ مِّن نّ۪ارٖ"},{"id":14,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":15,"text":"رَبُّ اُ۬لۡمَشۡرِقَيۡنِ وَرَبُّ اُ۬لۡمَغۡرِبَيۡنِ"},{"id":16,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":17,"text":"مَرَجَ اَ۬لۡبَحۡرَيۡنِ يَلۡتَقِيَانِ"},{"id":18,"text":"بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ"},{"id":19,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":20,"text":"يُخۡرَجُ مِنۡهُمَا اَ۬للُّؤۡلُؤُ وَاَلۡمَرۡجَانُ"},{"id":21,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":22,"text":"وَلَهُ اُ۬لۡجَوَارِ اِ۬لۡمُنشَـَٔاتُ فِي اِ۬لۡبَحۡرِ كَاَلۡأَعۡلَٰمِ"},{"id":23,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":24,"text":"كُلُّ مَنۡ عَلَيۡهَا فَانٖ"},{"id":25,"text":"وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو اُ۬لۡجَلَٰلِ وَاَلۡإِكۡرَامِ"},{"id":26,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":27,"text":"يَسۡـَٔلُهُۥ مَن فِي اِ۬لسَّمَٰوَٰتِ وَاَلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنٖ"},{"id":28,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":29,"text":"سَنَفۡرُغُ لَكُمۡ أَيُّهَ اَ۬لثَّقَلَانِ"},{"id":30,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":31,"text":"يَٰمَعۡشَرَ اَ۬لۡجِنِّ وَاَلۡإِنسِ إِنِ اِ۪سۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡط۪ارِ اِ۬لسَّمَٰوَٰتِ وَاَلۡأَرۡضِ فَاَنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنٖ"},{"id":32,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":33,"text":"يُرۡسَلُ عَلَيۡكُمَا شُوَاظٞ مِّن نّ۪ارٖ"},{"id":34,"text":"وَنُحَاسٖ فَلَا تَنتَصِرَانِ"},{"id":35,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":36,"text":"فَإِذَا اَ۪نشَقَّتِ اِ۬لسَّمَآءُ فَكَانَتۡ وَرۡدَةٗ كَاَلدِّهَانِ"},{"id":37,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":38,"text":"فَيَوۡمَئِذٖ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٞ وَلَا جَآنّٞ"},{"id":39,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":40,"text":"۞ يُعۡرَفُ اُ۬لۡمُجۡرِمُونَ بِسِيمٰۭهُمۡ فَيُؤۡخَذُ بِالنَّوَٰصِي وَاَلۡأَقۡدَامِ"},{"id":41,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":42,"text":"هَٰذِهِۦ جَهَنَّمُ اُ۬لَّتِي يُكَذِّبُ بِهَا اَ۬لۡمُجۡرِمُونَ"},{"id":43,"text":"يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانٖ"},{"id":44,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":45,"text":"وَلِمَنۡ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ"},{"id":46,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":47,"text":"ذَوَاتَآ أَفۡنَانٖ"},{"id":48,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":49,"text":"فِيهِمَا عَيۡنَانِ تَجۡرِيَانِ"},{"id":50,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":51,"text":"فِيهِمَا مِن كُلِّ فَٰكِهَةٖ زَوۡجَانِ"},{"id":52,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":53,"text":"مُتَّكِـِٔينَ عَلَىٰ فُرُشِۢ بَطَآئِنُهَا مِنۡ إِسۡتَبۡرَقٖۚ وَجَنَى اَ۬لۡجَنَّتَيۡنِ دَانٖ"},{"id":54,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":55,"text":"فِيهِنَّ قَٰصِرَٰتُ اُ۬لطَّرۡفِ لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ"},{"id":56,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":57,"text":"كَأَنَّهُنَّ اَ۬لۡيَاقُوتُ وَاَلۡمَرۡجَانُ"},{"id":58,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":59,"text":"هَلۡ جَزَآءُ اُ۬لۡإِحۡسَٰنِ إِلَّا اَ۬لۡإِحۡسَٰنُ"},{"id":60,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":61,"text":"وَمِن دُونِهِمَا جَنَّتَانِ"},{"id":62,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":63,"text":"مُدۡهَآمَّتَانِ"},{"id":64,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":65,"text":"فِيهِمَا عَيۡنَانِ نَضَّاخَتَانِ"},{"id":66,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":67,"text":"فِيهِمَا فَٰكِهَةٞ وَنَخۡلٞ وَرُمَّانٞ"},{"id":68,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":69,"text":"فِيهِنَّ خَيۡرَٰتٌ حِسَانٞ"},{"id":70,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":71,"text":"۞ حُورٞ مَّقۡصُورَٰتٞ فِي اِ۬لۡخِيَامِ"},{"id":72,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":73,"text":"لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ"},{"id":74,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":75,"text":"مُتَّكِـِٔينَ عَلَىٰ رَفۡرَفٍ خُضۡرٖ وَعَبۡقَرِيٍّ حِسَانٖ"},{"id":76,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":77,"text":"تَبَٰرَكَ اَ۪سۡمُ رَبِّكَ ذِي اِ۬لۡجَلَٰلِ وَاَلۡإِكۡرَامِ"}]