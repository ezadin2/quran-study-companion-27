[{"id":1,"text":"قُلۡ يَٰٓأَيُّهَا اَ۬لۡكَٰفِرُونَ"},{"id":2,"text":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ"},{"id":3,"text":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ"},{"id":4,"text":"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ"},{"id":5,"text":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ"},{"id":6,"text":"لَكُمۡ دِينُكُمۡ وَلِي دِينِ"}]