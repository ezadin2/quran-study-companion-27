[{"id":1,"text":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ"},{"id":2,"text":"اِ۬لَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ"},{"id":3,"text":"يَحۡسِبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ"},{"id":4,"text":"كَلَّاۖ لَيُنۢبَذَنَّ فِي اِ۬لۡحُطَمَةِ"},{"id":5,"text":"وَمَآ أَدۡر۪ىٰكَ مَا اَ۬لۡحُطَمَةُ"},{"id":6,"text":"نَارُ اُ۬للَّهِ اِ۬لۡمُوقَدَةُ"},{"id":7,"text":"اُ۬لَّتِي تَطَّلِعُ عَلَى اَ۬لۡأَفۡـِٔدَةِ"},{"id":8,"text":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ"},{"id":9,"text":"فِي عَمَدٖ مُّمَدَّدَةِۢ"}]