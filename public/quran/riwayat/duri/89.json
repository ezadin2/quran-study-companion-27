[{"id":1,"text":"وَاَلۡفَجۡرِ"},{"id":2,"text":"وَلَيَالٍ عَشۡرٖ"},{"id":3,"text":"وَاَلشَّفۡعِ وَاَلۡوَتۡرِ"},{"id":4,"text":"وَاَلَّيۡلِ إِذَا يَسۡرِۦ"},{"id":5,"text":"هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ"},{"id":6,"text":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ"},{"id":7,"text":"إِرَمَ ذَاتِ اِ۬لۡعِمَادِ"},{"id":8,"text":"اِ۬لَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي اِ۬لۡبِلَٰدِ"},{"id":9,"text":"وَثَمُودَ اَ۬لَّذِينَ جَابُواْ اُ۬لصَّخۡرَ بِالۡوَادِ"},{"id":10,"text":"وَفِرۡعَوۡنَ ذِي اِ۬لۡأَوۡتَادِ"},{"id":11,"text":"اِ۬لَّذِينَ طَغَوۡاْ فِي اِ۬لۡبِلَٰدِ"},{"id":12,"text":"فَأَكۡثَرُواْ فِيهَا اَ۬لۡفَسَادَ"},{"id":13,"text":"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ"},{"id":14,"text":"إِنَّ رَبَّكَ لَبِالۡمِرۡصَادِ"},{"id":15,"text":"فَأَمَّا اَ۬لۡإِنسَٰنُ إِذَا مَا اَ۪بۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ"},{"id":16,"text":"فَيَقُولُ رَبِّيَ أَكۡرَمَنِۦ"},{"id":17,"text":"وَأَمَّآ إِذَا مَا اَ۪بۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ"},{"id":18,"text":"فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ"},{"id":19,"text":"كَلَّاۖ بَل لَّا يُكۡرِمُونَ اَ۬لۡيَتِيمَ"},{"id":20,"text":"وَلَا يَحُضُّونَ عَلَىٰ طَعَامِ اِ۬لۡمِسۡكِينِ"},{"id":21,"text":"وَيَأۡكُلُونَ اَ۬لتُّرَاثَ أَكۡلٗا لَّمّٗا"},{"id":22,"text":"وَيُحِبُّونَ اَ۬لۡمَالَ حُبّٗا جَمّٗا"},{"id":23,"text":"كَلَّآ إِذَا دُكَّتِ اِ۬لۡأَرۡضُ دَكّٗا دَكّٗا"},{"id":24,"text":"وَجَآءَ رَبُّكَ وَاَلۡمَلَكُ صَفّٗا صَفّٗا"},{"id":25,"text":"وَجِاْيٓءَ يَوۡمَئِذِۢ بِجَهَنَّمَ"},{"id":26,"text":"يَوۡمَئِذٖ يَتَذَكَّرُ اُ۬لۡإِنسَٰنُ وَأَنّۭيٰ لَهُ اُ۬لذِّكۡر۪يٰ"},{"id":27,"text":"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي"},{"id":28,"text":"فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ"},{"id":29,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ"},{"id":30,"text":"يَٰٓأَيَّتُهَا اَ۬لنَّفۡسُ اُ۬لۡمُطۡمَئِنَّةُ"},{"id":31,"text":"اُ۪رۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ"},{"id":32,"text":"فَاَدۡخُلِي فِي عِبَٰدِي وَاَدۡخُلِي جَنَّتِي"}]