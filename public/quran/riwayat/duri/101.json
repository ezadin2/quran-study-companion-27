[{"id":1,"text":"اِ۬لۡقَارِعَةُ مَا اَ۬لۡقَارِعَةُ"},{"id":2,"text":"وَمَآ أَدۡر۪ىٰكَ مَا اَ۬لۡقَارِعَةُ"},{"id":3,"text":"يَوۡمَ يَكُونُ اُ۬لنَّاسُ كَاَلۡفَرَاشِ اِ۬لۡمَبۡثُوثِ"},{"id":4,"text":"وَتَكُونُ اُ۬لۡجِبَالُ كَاَلۡعِهۡنِ اِ۬لۡمَنفُوشِ"},{"id":5,"text":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ"},{"id":6,"text":"فَهۡوَ فِي عِيشَةٖ رَّاضِيَةٖ"},{"id":7,"text":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ"},{"id":8,"text":"فَأُمُّهُۥ هَاوِيَةٞ"},{"id":9,"text":"وَمَآ أَدۡر۪ىٰكَ مَا هِيَهۡ"},{"id":10,"text":"نَارٌ حَامِيَةُۢ"}]