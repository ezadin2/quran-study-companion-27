[{"id":1,"text":"لَآ أُقۡسِمُ بِهَٰذَا اَ۬لۡبَلَدِ"},{"id":2,"text":"وَأَنتَ حِلُّۢ بِهَٰذَا اَ۬لۡبَلَدِ"},{"id":3,"text":"وَوَالِدٖ وَمَا وَلَدَ"},{"id":4,"text":"لَقَدۡ خَلَقۡنَا اَ۬لۡإِنسَٰنَ فِي كَبَدٍ"},{"id":5,"text":"أَيَحۡسِبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدٞ"},{"id":6,"text":"يَقُولُ أَهۡلَكۡتُ مَالٗا لُّبَدًا"},{"id":7,"text":"أَيَحۡسِبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ"},{"id":8,"text":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ"},{"id":9,"text":"وَلِسَانٗا وَشَفَتَيۡنِ"},{"id":10,"text":"وَهَدَيۡنَٰهُ اُ۬لنَّجۡدَيۡنِ"},{"id":11,"text":"فَلَا اَ۪قۡتَحَمَ اَ۬لۡعَقَبَةَ"},{"id":12,"text":"وَمَآ أَدۡر۪ىٰكَ مَا اَ۬لۡعَقَبَةُ"},{"id":13,"text":"فَكَّ رَقَبَةً"},{"id":14,"text":"أَوۡ أَطۡعَمَ فِي يَوۡمٖ ذِي مَسۡغَبَةٖ"},{"id":15,"text":"يَتِيمٗا ذَا مَقۡرَبَةٍ"},{"id":16,"text":"أَوۡ مِسۡكِينٗا ذَا مَتۡرَبَةٖ"},{"id":17,"text":"ثُمَّ كَانَ مِنَ اَ۬لَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِالصَّبۡرِ وَتَوَاصَوۡاْ بِالۡمَرۡحَمَةِ"},{"id":18,"text":"أُوْلَٰٓئِكَ أَصۡحَٰبُ اُ۬لۡمَيۡمَنَةِ"},{"id":19,"text":"وَاَلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ اُ۬لۡمَشۡـَٔمَةِ"},{"id":20,"text":"عَلَيۡهِمۡ نَارٞ مُّؤۡصَدَةُۢ"}]