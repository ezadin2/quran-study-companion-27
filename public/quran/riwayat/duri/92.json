[{"id":1,"text":"وَاَلَّيۡلِ إِذَا يَغۡشۭيٰ"},{"id":2,"text":"وَاَلنَّه۪ارِ إِذَا تَجَلّۭيٰ"},{"id":3,"text":"وَمَا خَلَقَ اَ۬لذَّكَرَ وَاَلۡأُنثۭيٰٓ"},{"id":4,"text":"إِنَّ سَعۡيَكُمۡ لَشَتّۭيٰ"},{"id":5,"text":"فَأَمَّا مَنۡ أَعۡطَىٰ وَاَتَّقۭيٰ"},{"id":6,"text":"وَصَدَّقَ بِالۡحُسۡنۭيٰ"},{"id":7,"text":"فَسَنُيَسِّرُهُۥ لِلۡيُسۡر۪يٰ"},{"id":8,"text":"وَأَمَّا مَنۢ بَخِلَ وَاَسۡتَغۡنۭيٰ"},{"id":9,"text":"وَكَذَّبَ بِالۡحُسۡنۭيٰ"},{"id":10,"text":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡر۪يٰ"},{"id":11,"text":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدّۭيٰٓ"},{"id":12,"text":"إِنَّ عَلَيۡنَا لَلۡهُدۭيٰ"},{"id":13,"text":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَاَلۡأُولۭيٰ"},{"id":14,"text":"فَأَنذَرۡتُكُمۡ نَارٗا تَلَظّۭيٰ"},{"id":15,"text":"لَا يَصۡلَىٰهَآ إِلَّا اَ۬لۡأَشۡقَى"},{"id":16,"text":"اَ۬لَّذِي كَذَّبَ وَتَوَلّۭيٰ"},{"id":17,"text":"وَسَيُجَنَّبُهَا اَ۬لۡأَتۡقَى"},{"id":18,"text":"اَ۬لَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكّۭيٰ"},{"id":19,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزۭيٰٓ"},{"id":20,"text":"إِلَّا اَ۪بۡتِغَآءَ وَجۡهِ رَبِّهِ اِ۬لۡأَعۡلۭيٰ"},{"id":21,"text":"وَلَسَوۡفَ يَرۡضۭيٰ"}]