[{"id":1,"text":"إِذَا اَ۬لشَّمۡسُ كُوِّرَتۡ"},{"id":2,"text":"وَإِذَا اَ۬لنُّجُومُ اُ۪نكَدَرَتۡ"},{"id":3,"text":"وَإِذَا اَ۬لۡجِبَالُ سُيِّرَتۡ"},{"id":4,"text":"وَإِذَا اَ۬لۡعِشَارُ عُطِّلَتۡ"},{"id":5,"text":"وَإِذَا اَ۬لۡوُحُوشُ حُشِرَتۡ"},{"id":6,"text":"وَإِذَا اَ۬لۡبِحَارُ سُجِرَتۡ"},{"id":7,"text":"وَإِذَا اَ۬لنُّفُوسُ زُوِّجَتۡ"},{"id":8,"text":"وَإِذَا اَ۬لۡمَوۡءُۥدَةُ سُئِلَتۡ"},{"id":9,"text":"بِأَيِّ ذَنۢبٖ قُتِلَتۡ"},{"id":10,"text":"وَإِذَا اَ۬لصُّحُفُ نُشِّرَتۡ"},{"id":11,"text":"وَإِذَا اَ۬لسَّمَآءُ كُشِطَتۡ"},{"id":12,"text":"وَإِذَا اَ۬لۡجَحِيمُ سُعِرَتۡ"},{"id":13,"text":"وَإِذَا اَ۬لۡجَنَّةُ أُزۡلِفَتۡ"},{"id":14,"text":"عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ"},{"id":15,"text":"فَلَآ أُقۡسِمُ بِالۡخُنَّسِ"},{"id":16,"text":"اِ۬لۡجَوَارِ اِ۬لۡكُنَّسِ"},{"id":17,"text":"وَاَلَّيۡلِ إِذَا عَسۡعَسَ"},{"id":18,"text":"وَاَلصُّبۡحِ إِذَا تَنَفَّسَ"},{"id":19,"text":"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ"},{"id":20,"text":"ذِي قُوَّةٍ عِندَ ذِي اِ۬لۡعَرۡشِ مَكِينٖ"},{"id":21,"text":"مُّطَاعٖ ثَمَّ أَمِينٖ"},{"id":22,"text":"وَمَا صَاحِبُكُم بِمَجۡنُونٖ"},{"id":23,"text":"وَلَقَدۡ رَء۪اهُ بِالۡأُفُقِ اِ۬لۡمُبِينِ"},{"id":24,"text":"وَمَا هُوَ عَلَى اَ۬لۡغَيۡبِ بِضظَنِينٖ"},{"id":25,"text":"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ"},{"id":26,"text":"فَأَيۡنَ تَذۡهَبُونَ"},{"id":27,"text":"إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ"},{"id":28,"text":"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ"},{"id":29,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ اَ۬للَّهُ رَبُّ اُ۬لۡعَٰلَمِينَ"}]