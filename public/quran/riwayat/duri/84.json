[{"id":1,"text":"إِذَا اَ۬لسَّمَآءُ اُ۪نشَقَّتۡ"},{"id":2,"text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ"},{"id":3,"text":"وَإِذَا اَ۬لۡأَرۡضُ مُدَّتۡ"},{"id":4,"text":"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ"},{"id":5,"text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ"},{"id":6,"text":"يَٰٓأَيُّهَا اَ۬لۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ"},{"id":7,"text":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ"},{"id":8,"text":"فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا"},{"id":9,"text":"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا"},{"id":10,"text":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ"},{"id":11,"text":"فَسَوۡفَ يَدۡعُواْ ثُبُورٗا"},{"id":12,"text":"وَيَصۡلَىٰ سَعِيرًا"},{"id":13,"text":"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا"},{"id":14,"text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"},{"id":15,"text":"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا"},{"id":16,"text":"۞ فَلَآ أُقۡسِمُ بِالشَّفَقِ"},{"id":17,"text":"وَاَلَّيۡلِ وَمَا وَسَقَ"},{"id":18,"text":"وَاَلۡقَمَرِ إِذَا اَ۪تَّسَقَ"},{"id":19,"text":"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ"},{"id":20,"text":"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ"},{"id":21,"text":"وَإِذَا قُرِئَ عَلَيۡهِمِ اِ۬لۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩"},{"id":22,"text":"بَلِ اِ۬لَّذِينَ كَفَرُواْ يُكَذِّبُونَ"},{"id":23,"text":"وَاَللَّهُ أَعۡلَمُ بِمَا يُوعُونَ"},{"id":24,"text":"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ"},{"id":25,"text":"إِلَّا اَ۬لَّذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۢ"}]