[{"id":1,"text":"وَاَلنَّٰزِعَٰتِ غَرۡقٗا"},{"id":2,"text":"وَاَلنَّٰشِطَٰتِ نَشۡطٗا"},{"id":3,"text":"وَاَلسَّٰبِحَٰتِ سَبۡحٗا"},{"id":4,"text":"فَاَلسَّٰبِقَٰتِ سَبۡقٗا"},{"id":5,"text":"فَاَلۡمُدَبِّرَٰتِ أَمۡرٗا"},{"id":6,"text":"يَوۡمَ تَرۡجُفُ اُ۬لرَّاجِفَةُ"},{"id":7,"text":"تَتۡبَعُهَا اَ۬لرَّادِفَةُ"},{"id":8,"text":"قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ"},{"id":9,"text":"أَبۡصَٰرُهَا خَٰشِعَةٞ"},{"id":10,"text":"يَقُولُونَ أَٰ۟نَّا لَمَرۡدُودُونَ فِي اِ۬لۡحَافِرَةِ"},{"id":11,"text":"أَٰ۟ذَا كُنَّا عِظَٰمٗا نَّخِرَةٗ"},{"id":12,"text":"قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ"},{"id":13,"text":"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ"},{"id":14,"text":"فَإِذَا هُم بِالسَّاهِرَةِ"},{"id":15,"text":"هَلۡ أَتَىٰكَ حَدِيثُ مُوسۭيٰٓ"},{"id":16,"text":"إِذۡ نَادَىٰهُ رَبُّهُۥ بِالۡوَادِ اِ۬لۡمُقَدَّسِ طُوَى"},{"id":17,"text":"اَ۪ذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغۭيٰ"},{"id":18,"text":"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكّۭيٰ"},{"id":19,"text":"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشۭيٰ"},{"id":20,"text":"فَأَر۪ىٰهُ اُ۬لۡأٓيَةَ اَ۬لۡكُبۡر۪يٰ"},{"id":21,"text":"فَكَذَّبَ وَعَصۭيٰ"},{"id":22,"text":"ثُمَّ أَدۡبَرَ يَسۡعۭيٰ"},{"id":23,"text":"فَحَشَرَ فَنَادۭيٰ"},{"id":24,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ اُ۬لۡأَعۡلۭيٰ"},{"id":25,"text":"فَأَخَذَهُ اُ۬للَّهُ نَكَالَ اَ۬لۡأٓخِرَةِ وَاَلۡأُولۭيٰٓ"},{"id":26,"text":"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشۭيٰٓ"},{"id":27,"text":"ءَٰا۬نتُمۡ أَشَدُّ خَلۡقًا أَمِ اِ۬لسَّمَآءُۚ بَنۭىٰهَا"},{"id":28,"text":"رَفَعَ سَمۡكَهَا فَسَوّۭىٰهَا"},{"id":29,"text":"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحۭىٰهَا"},{"id":30,"text":"وَاَلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحۭىٰهَآ"},{"id":31,"text":"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعۭىٰهَا"},{"id":32,"text":"وَاَلۡجِبَالَ أَرۡسۭىٰهَا"},{"id":33,"text":"مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ"},{"id":34,"text":"فَإِذَا جَآءَتِ اِ۬لطَّآمَّةُ اُ۬لۡكُبۡر۪يٰ"},{"id":35,"text":"يَوۡمَ يَتَذَكَّرُ اُ۬لۡإِنسَٰنُ مَا سَعۭيٰ"},{"id":36,"text":"وَبُرِّزَتِ اِ۬لۡجَحِيمُ لِمَن يَر۪يٰ"},{"id":37,"text":"فَأَمَّا مَن طَغَىٰ وَءَاثَرَ اَ۬لۡحَيَوٰةَ اَ۬لدُّنۡيۭا"},{"id":38,"text":"فَإِنَّ اَ۬لۡجَحِيمَ هِيَ اَ۬لۡمَأۡوۭيٰ"},{"id":39,"text":"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى اَ۬لنَّفۡسَ عَنِ اِ۬لۡهَوۭيٰ"},{"id":40,"text":"فَإِنَّ اَ۬لۡجَنَّةَ هِيَ اَ۬لۡمَأۡوۭيٰ"},{"id":41,"text":"۞ يَسۡـَٔلُونَكَ عَنِ اِ۬لسَّاعَةِ أَيَّانَ مُرۡسۭىٰهَا"},{"id":42,"text":"فِيمَ أَنتَ مِن ذِكۡر۪ىٰهَآ"},{"id":43,"text":"إِلَىٰ رَبِّكَ مُنتَهۭىٰهَآ"},{"id":44,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشۭىٰهَا"},{"id":45,"text":"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحۭىٰهَا"}]