[{"id":1,"text":"اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ اِ۬لْفِيلِۖ"},{"id":2,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِے تَضْلِيلٖ"},{"id":3,"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْراً اَبَابِيلَ"},{"id":4,"text":"تَرْمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ"},{"id":5,"text":"فَجَعَلَهُمْ كَعَصْفٖ مَّاكُولٖۖ"}]