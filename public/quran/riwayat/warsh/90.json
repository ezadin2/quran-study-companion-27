[{"id":1,"text":"لَآ أُقْسِمُ بِهَٰذَا اَ۬لْبَلَدِ"},{"id":2,"text":"وَأَنتَ حِلُّۢ بِهَٰذَا اَ۬لْبَلَدِ"},{"id":3,"text":"وَوَالِدٖ وَمَا وَلَدَ"},{"id":4,"text":"لَقَدْ خَلَقْنَا اَ۬لِانسَٰنَ فِے كَبَدٍۖ"},{"id":5,"text":"اَيَحْسِبُ أَن لَّنْ يَّقْدِرَ عَلَيْهِ أَحَدٞ"},{"id":6,"text":"يَقُولُ أَهْلَكْتُ مَالاٗ لُّبَداًۖ"},{"id":7,"text":"اَيَحْسِبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌۖ"},{"id":8,"text":"اَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"},{"id":9,"text":"وَلِسَاناٗ وَشَفَتَيْنِ"},{"id":10,"text":"وَهَدَيْنَٰهُ اُ۬لنَّجْدَيْنِۖ"},{"id":11,"text":"فَلَا اَ۪قْتَحَمَ اَ۬لْعَقَبَةَۖ"},{"id":12,"text":"وَمَآ أَدْر۪يٰكَ مَا اَ۬لْعَقَبَةُۖ"},{"id":13,"text":"فَكُّ رَقَبَةٍ"},{"id":14,"text":"اَوِ اِطْعَامٞ فِے يَوْمٖ ذِے مَسْغَبَةٖ"},{"id":15,"text":"يَتِيماٗ ذَا مَقْرَبَةٍ"},{"id":16,"text":"اَوْ مِسْكِيناٗ ذَا مَتْرَبَةٖۖ"},{"id":17,"text":"ثُمَّ كَانَ مِنَ اَ۬لذِينَ ءَامَنُواْ وَتَوَاصَوْاْ بِالصَّبْرِ وَتَوَاصَوْاْ بِالْمَرْحَمَةِۖ"},{"id":18,"text":"أُوْلَٰٓئِكَ أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ"},{"id":19,"text":"وَالذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمُۥٓ أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ"},{"id":20,"text":"عَلَيْهِمْ نَارٞ مُّوصَدَةٞۖ"}]