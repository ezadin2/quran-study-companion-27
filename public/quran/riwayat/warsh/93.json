[{"id":1,"text":"وَالضُّح۪ىٰ"},{"id":2,"text":"وَاليْلِ إِذَا سَج۪ىٰ"},{"id":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَل۪ىٰۖ"},{"id":4,"text":"وَلَلَاخِرَةُ خَيْرٞ لَّكَ مِنَ اَ۬لُاول۪ىٰۖ"},{"id":5,"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْض۪ىٰٓۖ"},{"id":6,"text":"أَلَمْ يَجِدْكَ يَتِيماٗ فَـَٔاو۪ىٰ"},{"id":7,"text":"وَوَجَدَكَ ضَآلّاٗ فَهَد۪ىٰ"},{"id":8,"text":"وَوَجَدَكَ عَآئِلاٗ فَأَغْن۪ىٰۖ"},{"id":9,"text":"فَأَمَّا اَ۬لْيَتِيمَ فَلَا تَقْهَرْۖ"},{"id":10,"text":"وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنْهَرْۖ"},{"id":11,"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثَۖ"}]