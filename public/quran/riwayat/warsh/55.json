[{"id":1,"text":"اِ۬لرَّحْمَٰنُ عَلَّمَ اَ۬لْقُرْءَانَۖ"},{"id":2,"text":"خَلَقَ اَ۬لِانسَٰنَ عَلَّمَهُ اُ۬لْبَيَانَۖ"},{"id":3,"text":"اَ۬لشَّمْسُ وَالْقَمَرُ بِحُسْبَانٖۖ"},{"id":4,"text":"وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَٰنِۖ"},{"id":5,"text":"وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لْمِيزَانَ"},{"id":6,"text":"أَلَّا تَطْغَوْاْ فِے اِ۬لْمِيزَانِ"},{"id":7,"text":"وَأَقِيمُواْ اُ۬لْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُواْ اُ۬لْمِيزَانَۖ"},{"id":8,"text":"وَالَارْضَ وَضَعَهَا لِلَانَامِ"},{"id":9,"text":"فِيهَا فَٰكِهَةٞ وَالنَّخْلُ ذَاتُ اُ۬لَاكْمَامِ"},{"id":10,"text":"وَالْحَبُّ ذُو اُ۬لْعَصْفِ وَالرَّيْحَانُۖ"},{"id":11,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":12,"text":"خَلَقَ اَ۬لِانسَٰنَ مِن صَلْصَٰلٖ كَالْفَخّ۪ارِ"},{"id":13,"text":"وَخَلَقَ اَ۬لْجَآنَّ مِن مَّارِجٖ مِّن نّ۪ارٖۖ"},{"id":14,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":15,"text":"رَبُّ اُ۬لْمَشْرِقَيْنِ وَرَبُّ اُ۬لْمَغْرِبَيْنِۖ"},{"id":16,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":17,"text":"مَرَجَ اَ۬لْبَحْرَيْنِ يَلْتَقِيَٰنِ"},{"id":18,"text":"بَيْنَهُمَا بَرْزَخٞ لَّا يَبْغِيَٰنِۖ"},{"id":19,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":20,"text":"يُخْرَجُ مِنْهُمَا اَ۬للُّؤْلُؤُاْ وَالْمَرْجَانُۖ"},{"id":21,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":22,"text":"وَلَهُ اُ۬لْجَوَارِ اِ۬لْمُنشَأَٰتُ فِے اِ۬لْبَحْرِ كَالَاعْلَٰمِۖ"},{"id":23,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":24,"text":"كُلُّ مَنْ عَلَيْهَا فَانٖ"},{"id":25,"text":"وَيَبْق۪ىٰ وَجْهُ رَبِّكَ ذُو اُ۬لْجَلَٰلِ وَالِاكْرَامِۖ"},{"id":26,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":27,"text":"يَسْـَٔلُهُۥ مَن فِے اِ۬لسَّمَٰوَٰتِ وَالَارْضِ كُلَّ يَوْمٍ هُوَ فِے شَأْنٖۖ"},{"id":28,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":29,"text":"سَنَفْرُغُ لَكُمُۥٓ أَيُّهَ اَ۬لثَّقَلَٰنِۖ"},{"id":30,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":31,"text":"يَٰمَعْشَرَ اَ۬لْجِنِّ وَالِانسِ إِنِ اِ۪سْتَطَعْتُمُۥٓ أَن تَنفُذُواْ مِنَ اَقْط۪ارِ اِ۬لسَّمَٰوَٰتِ وَالَارْضِ فَانفُذُواْۖ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٖۖ"},{"id":32,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":33,"text":"يُرْسَلُ عَلَيْكُمَا شُوَاظٞ مِّن نّ۪ارٖ"},{"id":34,"text":"وَنُحَاسٞ فَلَا تَنتَصِرَٰنِۖ"},{"id":35,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":36,"text":"فَإِذَا اَ۪نشَقَّتِ اِ۬لسَّمَآءُ فَكَانَتْ وَرْدَةٗ كَالدِّهَانِ"},{"id":37,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":38,"text":"فَيَوْمَئِذٖ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٞ وَلَا جَآنّٞۖ"},{"id":39,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":40,"text":"۞ يُعْرَفُ اُ۬لْمُجْرِمُونَ بِسِيمٰ۪هُمْ فَيُوخَذُ بِالنَّوَٰصِے وَالَاقْدَامِۖ"},{"id":41,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":42,"text":"هَٰذِهِۦ جَهَنَّمُ اُ۬لتِے يُكَذِّبُ بِهَا اَ۬لْمُجْرِمُونَ"},{"id":43,"text":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ اٰنٖۖ"},{"id":44,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":45,"text":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَٰنِ"},{"id":46,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":47,"text":"ذَوَاتَآ أَفْنَانٖۖ"},{"id":48,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":49,"text":"فِيهِمَا عَيْنَٰنِ تَجْرِيَٰنِۖ"},{"id":50,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":51,"text":"فِيهِمَا مِن كُلِّ فَٰكِهَةٖ زَوْجَٰنِۖ"},{"id":52,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":53,"text":"مُتَّكِـِٕينَ عَلَىٰ فُرُشِۢ بَطَآئِنُهَا مِنِ اِسْتَبْرَقٖ وَجَنَا اَ۬لْجَنَّتَيْنِ دَانٖۖ"},{"id":54,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":55,"text":"فِيهِنَّ قَٰصِرَٰتُ اُ۬لطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٞ قَبْلَهُمْ وَلَا جَآنّٞۖ"},{"id":56,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":57,"text":"كَأَنَّهُنَّ اَ۬لْيَاقُوتُ وَالْمَرْجَانُۖ"},{"id":58,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":59,"text":"هَلْ جَزَآءُ اُ۬لِاحْسَٰنِ إِلَّا اَ۬لِاحْسَٰنُۖ"},{"id":60,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":61,"text":"وَمِن دُونِهِمَا جَنَّتَٰنِ"},{"id":62,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":63,"text":"مُدْهَآمَّتَٰنِۖ"},{"id":64,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":65,"text":"فِيهِمَا عَيْنَٰنِ نَضَّاخَتَٰنِۖ"},{"id":66,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":67,"text":"فِيهِمَا فَٰكِهَةٞ وَنَخْلٞ وَرُمَّانٞۖ"},{"id":68,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":69,"text":"فِيهِنَّ خَيْرَٰتٌ حِسَانٞۖ"},{"id":70,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":71,"text":"حُورٞ مَّقْصُورَٰتٞ فِے اِ۬لْخِيَامِۖ"},{"id":72,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":73,"text":"لَمْ يَطْمِثْهُنَّ إِنسٞ قَبْلَهُمْ وَلَا جَآنّٞۖ"},{"id":74,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":75,"text":"مُتَّكِـِٕينَ عَلَىٰ رَفْرَفٍ خُضْرٖ وَعَبْقَرِيٍّ حِسَانٖۖ"},{"id":76,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"id":77,"text":"تَبَٰرَكَ اَ۪سْمُ رَبِّكَ ذِے اِ۬لْجَلَٰلِ وَالِاكْرَامِۖ"}]