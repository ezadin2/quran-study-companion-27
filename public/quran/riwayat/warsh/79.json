[{"id":1,"text":"وَالنَّٰزِعَٰتِ غَرْقاٗ"},{"id":2,"text":"وَالنَّٰشِطَٰتِ نَشْطاٗ"},{"id":3,"text":"وَالسَّٰبِحَٰتِ سَبْحاٗ"},{"id":4,"text":"فَالسَّٰبِقَٰتِ سَبْقاٗ"},{"id":5,"text":"فَالْمُدَبِّرَٰتِ أَمْراٗ"},{"id":6,"text":"يَوْمَ تَرْجُفُ اُ۬لرَّاجِفَةُ"},{"id":7,"text":"تَتْبَعُهَا اَ۬لرَّادِفَةُۖ"},{"id":8,"text":"قُلُوبٞ يَوْمَئِذٖ وَاجِفَةٌ"},{"id":9,"text":"اَبْصَٰرُهَا خَٰشِعَةٞۖ"},{"id":10,"text":"يَقُولُونَ أَ۟نَّا لَمَرْدُودُونَ فِے اِ۬لْحَافِرَةِ"},{"id":11,"text":"إِذَا كُنَّا عِظَٰماٗ نَّخِرَةٗۖ"},{"id":12,"text":"قَالُواْ تِلْكَ إِذاٗ كَرَّةٌ خَاسِرَةٞ"},{"id":13,"text":"فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ"},{"id":14,"text":"فَإِذَا هُم بِالسَّاهِرَةِۖ"},{"id":15,"text":"هَلَ اَت۪يٰكَ حَدِيثُ مُوس۪ىٰٓ"},{"id":16,"text":"إِذْ نَاد۪يٰهُ رَبُّهُۥ بِالْوَادِ اِ۬لْمُقَدَّسِ طُوَىۖ"},{"id":17,"text":"اَ۪ذْهَبِ اِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغ۪ىٰ"},{"id":18,"text":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَّكّ۪ىٰ"},{"id":19,"text":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْش۪ىٰۖ"},{"id":20,"text":"فَأَر۪يٰهُ اُ۬لَايَةَ اَ۬لْكُبْر۪ىٰ"},{"id":21,"text":"فَكَذَّبَ وَعَص۪ىٰ"},{"id":22,"text":"ثُمَّ أَدْبَرَ يَسْع۪ىٰ"},{"id":23,"text":"فَحَشَرَ فَنَاد۪ىٰ"},{"id":24,"text":"فَقَالَ أَنَا رَبُّكُمُ اُ۬لَاعْل۪ىٰ"},{"id":25,"text":"فَأَخَذَهُ اُ۬للَّهُ نَكَالَ اَ۬لَاخِرَةِ وَالُاول۪ىٰٓۖ"},{"id":26,"text":"إِنَّ فِے ذَٰلِكَ لَعِبْرَةٗ لِّمَنْ يَّخْش۪ىٰٓۖ"},{"id":27,"text":"ءَآنتُمُۥٓ أَشَدُّ خَلْقاً اَمِ اِ۬لسَّمَآءُۖ بَنَيٰهَا"},{"id":28,"text":"رَفَعَ سَمْكَهَا فَسَوَّيٰهَا"},{"id":29,"text":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَيٰهَاۖ"},{"id":30,"text":"وَالَارْضَ بَعْدَ ذَٰلِكَ دَحَيٰهَآ"},{"id":31,"text":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَيٰهَا"},{"id":32,"text":"وَالْجِبَالَ أَرْسَيٰهَا"},{"id":33,"text":"مَتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ"},{"id":34,"text":"فَإِذَا جَآءَتِ اِ۬لطَّآمَّةُ اُ۬لْكُبْر۪ىٰ"},{"id":35,"text":"يَوْمَ يَتَذَكَّرُ اُ۬لِانسَٰنُ مَا سَع۪ىٰ"},{"id":36,"text":"وَبُرِّزَتِ اِ۬لْجَحِيمُ لِمَنْ يَّر۪ىٰۖ"},{"id":37,"text":"فَأَمَّا مَن طَغ۪ىٰ وَءَاثَرَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْي۪ا"},{"id":38,"text":"فَإِنَّ اَ۬لْجَحِيمَ هِيَ اَ۬لْمَأْو۪ىٰۖ"},{"id":39,"text":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى اَ۬لنَّفْسَ عَنِ اِ۬لْهَو۪ىٰ"},{"id":40,"text":"فَإِنَّ اَ۬لْجَنَّةَ هِيَ اَ۬لْمَأْو۪ىٰۖ"},{"id":41,"text":"۞ يَسْـَٔلُونَكَ عَنِ اِ۬لسَّاعَةِ أَيَّانَ مُرْسَيٰهَاۖ"},{"id":42,"text":"فِيمَ أَنتَ مِن ذِكْر۪يٰهَآۖ"},{"id":43,"text":"إِلَىٰ رَبِّكَ مُنتَهَيٰهَآۖ"},{"id":44,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَنْ يَّخْشَيٰهَاۖ"},{"id":45,"text":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓاْ إِلَّا عَشِيَّةً اَوْ ضُحَيٰهَاۖ"}]