[{"id":1,"text":"وَالصَّٰٓفَّٰتِ صَفّاٗ"},{"id":2,"text":"فَالزَّٰجِرَٰتِ زَجْراٗ"},{"id":3,"text":"فَالتَّٰلِيَٰتِ ذِكْراً"},{"id":4,"text":"اِنَّ إِلَٰهَكُمْ لَوَٰحِدٞۖ"},{"id":5,"text":"رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَا وَرَبُّ اُ۬لْمَشَٰرِقِۖ"},{"id":6,"text":"إِنَّا زَيَّنَّا اَ۬لسَّمَآءَ اَ۬لدُّنْي۪ا بِزِينَةِ اِ۬لْكَوَاكِبِۖ"},{"id":7,"text":"وَحِفْظاٗ مِّن كُلِّ شَيْطَٰنٖ مَّارِدٖۖ"},{"id":8,"text":"لَّا يَسْمَعُونَ إِلَى اَ۬لْمَلَإِ اِ۬لَاعْل۪ىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٖۖ"},{"id":9,"text":"دُحُوراٗۖ وَلَهُمْ عَذَابٞ وَاصِبٌ"},{"id":10,"text":"اِلَّا مَنْ خَطِفَ اَ۬لْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٞ ثَاقِبٞۖ"},{"id":11,"text":"فَاسْتَفْتِهِمُۥٓ أَهُمُۥٓ أَشَدُّ خَلْقاً اَم مَّنْ خَلَقْنَآۖ إِنَّا خَلَقْنَٰهُم مِّن طِينٖ لَّٰزِبِۢۖ"},{"id":12,"text":"بَلْ عَجِبْتَ وَيَسْخَرُونَۖ"},{"id":13,"text":"وَإِذَا ذُكِّرُواْ لَا يَذْكُرُونَۖ"},{"id":14,"text":"وَإِذَا رَأَوَاْ اٰيَةٗ يَسْتَسْخِرُونَۖ"},{"id":15,"text":"وَقَالُوٓاْ إِنْ هَٰذَآ إِلَّا سِحْرٞ مُّبِينٌ"},{"id":16,"text":"اَ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَبْعُوثُونَ"},{"id":17,"text":"أَوَ ءَابَآؤُنَا اَ۬لَاوَّلُونَۖ"},{"id":18,"text":"قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَۖ"},{"id":19,"text":"فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ فَإِذَا هُمْ يَنظُرُونَۖ"},{"id":20,"text":"وَقَالُواْ يَٰوَيْلَنَا هَٰذَا يَوْمُ اُ۬لدِّينِۖ"},{"id":21,"text":"هَٰذَا يَوْمُ اُ۬لْفَصْلِ اِ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ"},{"id":22,"text":"۞ اَ۟حْشُرُواْ اُ۬لذِينَ ظَلَمُواْ وَأَزْوَٰجَهُمْ وَمَا كَانُواْ يَعْبُدُونَ"},{"id":23,"text":"مِن دُونِ اِ۬للَّهِ فَاهْدُوهُمُۥٓ إِلَىٰ صِرَٰطِ اِ۬لْجَحِيمِۖ"},{"id":24,"text":"وَقِفُوهُمُۥٓ إِنَّهُم مَّسْـُٔولُونَۖ"},{"id":25,"text":"مَا لَكُمْ لَا تَنَاصَرُونَۖ"},{"id":26,"text":"بَلْ هُمُ اُ۬لْيَوْمَ مُسْتَسْلِمُونَۖ"},{"id":27,"text":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَسَآءَلُونَۖ"},{"id":28,"text":"قَالُوٓاْ إِنَّكُمْ كُنتُمْ تَاتُونَنَا عَنِ اِ۬لْيَمِينِۖ"},{"id":29,"text":"قَالُواْ بَل لَّمْ تَكُونُواْ مُومِنِينَۖ"},{"id":30,"text":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنِۢ بَلْ كُنتُمْ قَوْماٗ طَٰغِينَۖ"},{"id":31,"text":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ إِنَّا لَذَآئِقُونَ"},{"id":32,"text":"فَأَغْوَيْنَٰكُمُۥٓ إِنَّا كُنَّا غَٰوِينَۖ"},{"id":33,"text":"فَإِنَّهُمْ يَوْمَئِذٖ فِے اِ۬لْعَذَابِ مُشْتَرِكُونَۖ"},{"id":34,"text":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ"},{"id":35,"text":"إِنَّهُمْ كَانُوٓاْ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا اَ۬للَّهُ يَسْتَكْبِرُونَ"},{"id":36,"text":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجْنُونِۢۖ"},{"id":37,"text":"بَلْ جَآءَ بِالْحَقِّ وَصَدَّقَ اَ۬لْمُرْسَلِينَۖ"},{"id":38,"text":"إِنَّكُمْ لَذَآئِقُواْ اُ۬لْعَذَابِ اِ۬لَالِيمِۖ"},{"id":39,"text":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ"},{"id":40,"text":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ"},{"id":41,"text":"أُوْلَٰٓئِكَ لَهُمْ رِزْقٞ مَّعْلُومٞ"},{"id":42,"text":"فَوَٰكِهُۖ وَهُم مُّكْرَمُونَ"},{"id":43,"text":"فِے جَنَّٰتِ اِ۬لنَّعِيمِ"},{"id":44,"text":"عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَۖ"},{"id":45,"text":"يُطَافُ عَلَيْهِم بِكَأْسٖ مِّن مَّعِينِۢ"},{"id":46,"text":"بَيْضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ"},{"id":47,"text":"لَا فِيهَا غَوْلٞ وَلَا هُمْ عَنْهَا يُنزَفُونَۖ"},{"id":48,"text":"وَعِندَهُمْ قَٰصِرَٰتُ اُ۬لطَّرْفِ عِينٞ"},{"id":49,"text":"كَأَنَّهُنَّ بَيْضٞ مَّكْنُونٞۖ"},{"id":50,"text":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَسَآءَلُونَۖ"},{"id":51,"text":"۞ قَالَ قَآئِلٞ مِّنْهُمُۥٓ إِنِّے كَانَ لِے قَرِينٞ"},{"id":52,"text":"يَقُولُ أَ۟نَّكَ لَمِنَ اَ۬لْمُصَدِّقِينَ"},{"id":53,"text":"أَ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَدِينُونَۖ"},{"id":54,"text":"قَالَ هَلَ اَنتُم مُّطَّلِعُونَ"},{"id":55,"text":"فَاطَّلَعَ فَر۪ء۪اهُ فِے سَوَآءِ اِ۬لْجَحِيمِۖ"},{"id":56,"text":"قَالَ تَاللَّهِ إِن كِدتَّ لَتُرْدِينِۦ"},{"id":57,"text":"وَلَوْلَا نِعْمَةُ رَبِّے لَكُنتُ مِنَ اَ۬لْمُحْضَرِينَۖ"},{"id":58,"text":"أَفَمَا نَحْنُ بِمَيِّتِينَ"},{"id":59,"text":"إِلَّا مَوْتَتَنَا اَ۬لُاول۪ىٰ وَمَا نَحْنُ بِمُعَذَّبِينَۖ"},{"id":60,"text":"إِنَّ هَٰذَا لَهُوَ اَ۬لْفَوْزُ اُ۬لْعَظِيمُۖ"},{"id":61,"text":"لِمِثْلِ هَٰذَا فَلْيَعْمَلِ اِ۬لْعَٰمِلُونَۖ"},{"id":62,"text":"أَذَٰلِكَ خَيْرٞ نُّزُلاً اَمْ شَجَرَةُ اُ۬لزَّقُّومِۖ"},{"id":63,"text":"إِنَّا جَعَلْنَٰهَا فِتْنَةٗ لِّلظَّٰلِمِينَۖ"},{"id":64,"text":"إِنَّهَا شَجَرَةٞ تَخْرُجُ فِےٓ أَصْلِ اِ۬لْجَحِيمِ"},{"id":65,"text":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ اُ۬لشَّيَٰطِينِۖ"},{"id":66,"text":"فَإِنَّهُمْ لَأٓكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ"},{"id":67,"text":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْباٗ مِّنْ حَمِيمٖۖ"},{"id":68,"text":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى اَ۬لْجَحِيمِۖ"},{"id":69,"text":"إِنَّهُمُۥٓ أَلْفَوَاْ اٰبَآءَهُمْ ضَآلِّينَ"},{"id":70,"text":"فَهُمْ عَلَىٰٓ ءَاثٰ۪رِهِمْ يُهْرَعُونَۖ"},{"id":71,"text":"وَلَقَد ضَّلَّ قَبْلَهُمُۥٓ أَكْثَرُ اُ۬لَاوَّلِينَۖ"},{"id":72,"text":"وَلَقَدَ اَرْسَلْنَا فِيهِم مُّنذِرِينَۖ"},{"id":73,"text":"فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُنذَرِينَ"},{"id":74,"text":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ"},{"id":75,"text":"وَلَقَدْ نَاد۪يٰنَا نُوحٞ فَلَنِعْمَ اَ۬لْمُجِيبُونَۖ"},{"id":76,"text":"وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ"},{"id":77,"text":"وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ اُ۬لْبَاقِينَۖ"},{"id":78,"text":"وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ"},{"id":79,"text":"سَلَٰمٌ عَلَىٰ نُوحٖ فِے اِ۬لْعَٰلَمِينَۖ"},{"id":80,"text":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"},{"id":81,"text":"إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ"},{"id":82,"text":"ثُمَّ أَغْرَقْنَا اَ۬لَاخَرِينَۖ"},{"id":83,"text":"۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ"},{"id":84,"text":"إِذْ جَآءَ رَبَّهُۥ بِقَلْبٖ سَلِيمٍ"},{"id":85,"text":"اِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَۖ"},{"id":86,"text":"أَئِفْكاً اٰلِهَةٗ دُونَ اَ۬للَّهِ تُرِيدُونَۖ"},{"id":87,"text":"فَمَا ظَنُّكُم بِرَبِّ اِ۬لْعَٰلَمِينَۖ"},{"id":88,"text":"فَنَظَرَ نَظْرَةٗ فِے اِ۬لنُّجُومِ"},{"id":89,"text":"فَقَالَ إِنِّے سَقِيمٞ"},{"id":90,"text":"فَتَوَلَّوْاْ عَنْهُ مُدْبِرِينَۖ"},{"id":91,"text":"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَاكُلُونَ"},{"id":92,"text":"مَا لَكُمْ لَا تَنطِقُونَۖ"},{"id":93,"text":"فَرَاغَ عَلَيْهِمْ ضَرْباَۢ بِالْيَمِينِ"},{"id":94,"text":"فَأَقْبَلُوٓاْ إِلَيْهِ يَزِفُّونَۖ"},{"id":95,"text":"قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ"},{"id":96,"text":"وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَۖ"},{"id":97,"text":"قَالُواْ اُ۪بْنُواْ لَهُۥ بُنْيَٰناٗ فَأَلْقُوهُ فِے اِ۬لْجَحِيمِ"},{"id":98,"text":"فَأَرَادُواْ بِهِۦ كَيْداٗ فَجَعَلْنَٰهُمُ اُ۬لَاسْفَلِينَۖ"},{"id":99,"text":"وَقَالَ إِنِّے ذَاهِبٌ اِلَىٰ رَبِّے سَيَهْدِينِۖ"},{"id":100,"text":"رَبِّ هَبْ لِے مِنَ اَ۬لصَّٰلِحِينَۖ"},{"id":101,"text":"فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمٖۖ"},{"id":102,"text":"فَلَمَّا بَلَغَ مَعَهُ اُ۬لسَّعْيَ قَالَ يَٰبُنَيِّ إِنِّيَ أَر۪ىٰ فِے اِ۬لْمَنَامِ أَنِّيَ أَذْبَحُكَ فَانظُرْ مَاذَا تَر۪ىٰۖ قَالَ يَٰٓأَبَتِ اِ۪فْعَلْ مَا تُومَرُۖ سَتَجِدُنِيَ إِن شَآءَ اَ۬للَّهُ مِنَ اَ۬لصَّٰبِرِينَۖ"},{"id":103,"text":"فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ"},{"id":104,"text":"وَنَٰدَيْنَٰهُ أَنْ يَّٰٓإِبْرَٰهِيمُ"},{"id":105,"text":"قَدْ صَدَّقْتَ اَ۬لرُّءْي۪آۖ إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"},{"id":106,"text":"إِنَّ هَٰذَا لَهُوَ اَ۬لْبَلَٰٓؤُاْ اُ۬لْمُبِينُۖ"},{"id":107,"text":"وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٖۖ"},{"id":108,"text":"وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ"},{"id":109,"text":"سَلَٰمٌ عَلَىٰٓ إِبْرَٰهِيمَۖ"},{"id":110,"text":"كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"},{"id":111,"text":"إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ"},{"id":112,"text":"وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيٓـٔاٗ مِّنَ اَ۬لصَّٰلِحِينَ"},{"id":113,"text":"وَبَٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَٰقَۖ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٞ وَظَالِمٞ لِّنَفْسِهِۦ مُبِينٞۖ"},{"id":114,"text":"۞ وَلَقَدْ مَنَنَّا عَلَىٰ مُوس۪ىٰ وَهَٰرُونَ"},{"id":115,"text":"وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ"},{"id":116,"text":"وَنَصَرْنَٰهُمْ فَكَانُواْ هُمُ اُ۬لْغَٰلِبِينَۖ"},{"id":117,"text":"وَءَاتَيْنَٰهُمَا اَ۬لْكِتَٰبَ اَ۬لْمُسْتَبِينَۖ"},{"id":118,"text":"وَهَدَيْنَٰهُمَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَۖ"},{"id":119,"text":"وَتَرَكْنَا عَلَيْهِمَا فِے اِ۬لَاخِرِينَۖ"},{"id":120,"text":"سَلَٰمٌ عَلَىٰ مُوس۪ىٰ وَهَٰرُونَۖ"},{"id":121,"text":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"},{"id":122,"text":"إِنَّهُمَا مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ"},{"id":123,"text":"وَإِنَّ إِلْيَاسَ لَمِنَ اَ۬لْمُرْسَلِينَ"},{"id":124,"text":"إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ"},{"id":125,"text":"أَتَدْعُونَ بَعْلاٗ وَتَذَرُونَ أَحْسَنَ اَ۬لْخَٰلِقِينَۖ"},{"id":126,"text":"اَ۬للَّهُ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ اُ۬لَاوَّلِينَۖ"},{"id":127,"text":"فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ"},{"id":128,"text":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ"},{"id":129,"text":"وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ"},{"id":130,"text":"سَلَٰمٌ عَلَىٰٓ ءَالِ يَاسِينَۖ"},{"id":131,"text":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"},{"id":132,"text":"إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ"},{"id":133,"text":"وَإِنَّ لُوطاٗ لَّمِنَ اَ۬لْمُرْسَلِينَ"},{"id":134,"text":"إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ"},{"id":135,"text":"إِلَّا عَجُوزاٗ فِے اِ۬لْغَٰبِرِينَ"},{"id":136,"text":"ثُمَّ دَمَّرْنَا اَ۬لَاخَرِينَۖ"},{"id":137,"text":"وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ"},{"id":138,"text":"وَبِاليْلِۖ أَفَلَا تَعْقِلُونَۖ"},{"id":139,"text":"وَإِنَّ يُونُسَ لَمِنَ اَ۬لْمُرْسَلِينَ"},{"id":140,"text":"إِذَ اَبَقَ إِلَى اَ۬لْفُلْكِ اِ۬لْمَشْحُونِ"},{"id":141,"text":"فَسَاهَمَ فَكَانَ مِنَ اَ۬لْمُدْحَضِينَ"},{"id":142,"text":"فَالْتَقَمَهُ اُ۬لْحُوتُ وَهُوَ مُلِيمٞۖ"},{"id":143,"text":"فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ اَ۬لْمُسَبِّحِينَ"},{"id":144,"text":"لَلَبِثَ فِے بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَۖ"},{"id":145,"text":"۞ فَنَبَذْنَٰهُ بِالْعَرَآءِ وَهُوَ سَقِيمٞۖ"},{"id":146,"text":"وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةٗ مِّنْ يَّقْطِينٖۖ"},{"id":147,"text":"وَأَرْسَلْنَٰهُ إِلَىٰ مِاْئَةِ أَلْفٍ اَوْ يَزِيدُونَۖ"},{"id":148,"text":"فَـَٔامَنُواْ فَمَتَّعْنَٰهُمُۥٓ إِلَىٰ حِينٖۖ"},{"id":149,"text":"فَاسْتَفْتِهِمُۥٓ أَلِرَبِّكَ اَ۬لْبَنَاتُ وَلَهُمُ اُ۬لْبَنُونَۖ"},{"id":150,"text":"أَمْ خَلَقْنَا اَ۬لْمَلَٰٓئِكَةَ إِنَٰثاٗ وَهُمْ شَٰهِدُونَۖ"},{"id":151,"text":"أَلَآ إِنَّهُم مِّنِ اِفْكِهِمْ لَيَقُولُونَ"},{"id":152,"text":"وَلَدَ اَ۬للَّهُ وَإِنَّهُمْ لَكَٰذِبُونَۖ"},{"id":153,"text":"أَصْطَفَى اَ۬لْبَنَاتِ عَلَى اَ۬لْبَنِينَۖ"},{"id":154,"text":"مَا لَكُمْۖ كَيْفَ تَحْكُمُونَۖ"},{"id":155,"text":"أَفَلَا تَذَّكَّرُونَۖ"},{"id":156,"text":"أَمْ لَكُمْ سُلْطَٰنٞ مُّبِينٞ"},{"id":157,"text":"فَاتُواْ بِكِتَٰبِكُمُۥٓ إِن كُنتُمْ صَٰدِقِينَۖ"},{"id":158,"text":"وَجَعَلُواْ بَيْنَهُۥ وَبَيْنَ اَ۬لْجِنَّةِ نَسَباٗۖ وَلَقَدْ عَلِمَتِ اِ۬لْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَۖ"},{"id":159,"text":"سُبْحَٰنَ اَ۬للَّهِ عَمَّا يَصِفُونَۖ"},{"id":160,"text":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ"},{"id":161,"text":"فَإِنَّكُمْ وَمَا تَعْبُدُونَ"},{"id":162,"text":"مَآ أَنتُمْ عَلَيْهِ بِفَٰتِنِينَ"},{"id":163,"text":"إِلَّا مَنْ هُوَ صَالِ اِ۬لْجَحِيمِۖ"},{"id":164,"text":"وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٞ مَّعْلُومٞۖ"},{"id":165,"text":"وَإِنَّا لَنَحْنُ اُ۬لصَّآفُّونَ"},{"id":166,"text":"وَإِنَّا لَنَحْنُ اُ۬لْمُسَبِّحُونَۖ"},{"id":167,"text":"وَإِن كَانُواْ لَيَقُولُونَ"},{"id":168,"text":"لَوَ اَنَّ عِندَنَا ذِكْراٗ مِّنَ اَ۬لَاوَّلِينَ"},{"id":169,"text":"لَكُنَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ"},{"id":170,"text":"فَكَفَرُواْ بِهِۦۖ فَسَوْفَ يَعْلَمُونَۖ"},{"id":171,"text":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا اَ۬لْمُرْسَلِينَ"},{"id":172,"text":"إِنَّهُمْ لَهُمُ اُ۬لْمَنصُورُونَ"},{"id":173,"text":"وَإِنَّ جُندَنَا لَهُمُ اُ۬لْغَٰلِبُونَۖ"},{"id":174,"text":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٖۖ"},{"id":175,"text":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَۖ"},{"id":176,"text":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَۖ"},{"id":177,"text":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ اُ۬لْمُنذَرِينَۖ"},{"id":178,"text":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٖۖ"},{"id":179,"text":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَۖ"},{"id":180,"text":"سُبْحَٰنَ رَبِّكَ رَبِّ اِ۬لْعِزَّةِ عَمَّا يَصِفُونَۖ"},{"id":181,"text":"وَسَلَٰمٌ عَلَى اَ۬لْمُرْسَلِينَۖ"},{"id":182,"text":"وَالْحَمْدُ لِلهِ رَبِّ اِ۬لْعَٰلَمِينَۖ"}]