[{"id":1,"text":"اَ۪قْرَأْ بِاسْمِ رَبِّكَ اَ۬لذِے خَلَقَۖ"},{"id":2,"text":"خَلَقَ اَ۬لِانسَٰنَ مِنْ عَلَقٍۖ"},{"id":3,"text":"اِ۪قْرَأْ وَرَبُّكَ اَ۬لَاكْرَمُ"},{"id":4,"text":"اُ۬لذِے عَلَّمَ بِالْقَلَمِ"},{"id":5,"text":"عَلَّمَ اَ۬لِانسَٰنَ مَا لَمْ يَعْلَمْۖ"},{"id":6,"text":"كَلَّآ إِنَّ اَ۬لِانسَٰنَ لَيَطْغ۪ىٰٓ"},{"id":7,"text":"أَن رّ۪ء۪اهُ اُ۪سْتَغْن۪ىٰٓۖ"},{"id":8,"text":"إِنَّ إِلَىٰ رَبِّكَ اَ۬لرُّجْع۪ىٰٓۖ"},{"id":9,"text":"أَرَٰٓيْتَ اَ۬لذِے يَنْه۪ىٰ"},{"id":10,"text":"عَبْداً اِذَا صَلّ۪ىٰٓۖ"},{"id":11,"text":"أَرَٰٓيْتَ إِن كَانَ عَلَى اَ۬لْهُد۪ىٰٓ"},{"id":12,"text":"أَوَ اَمَرَ بِالتَّقْو۪ىٰٓۖ"},{"id":13,"text":"أَرَٰٓيْتَ إِن كَذَّبَ وَتَوَلّ۪ىٰٓ"},{"id":14,"text":"أَلَمْ يَعْلَم بِأَنَّ اَ۬للَّهَ يَر۪ىٰۖ"},{"id":15,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ"},{"id":16,"text":"لَنَسْفَعاَۢ بِالنَّاصِيَةِ"},{"id":17,"text":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖۖ"},{"id":18,"text":"فَلْيَدْعُ نَادِيَهُۥ"},{"id":19,"text":"سَنَدْعُ اُ۬لزَّبَانِيَةَۖ"},{"id":20,"text":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبِۖ"}]