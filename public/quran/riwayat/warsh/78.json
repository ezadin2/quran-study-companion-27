[{"id":1,"text":"عَمَّۖ يَتَسَآءَلُونَ"},{"id":2,"text":"عَنِ اِ۬لنَّبَإِ اِ۬لْعَظِيمِ"},{"id":3,"text":"اِ۬لذِے هُمْ فِيهِ مُخْتَلِفُونَۖ"},{"id":4,"text":"كَلَّا سَيَعْلَمُونَ"},{"id":5,"text":"ثُمَّ كَلَّا سَيَعْلَمُونَۖ"},{"id":6,"text":"أَلَمْ نَجْعَلِ اِ۬لَارْضَ مِهَٰداٗ"},{"id":7,"text":"وَالْجِبَالَ أَوْتَاداٗ"},{"id":8,"text":"وَخَلَقْنَٰكُمُۥٓ أَزْوَٰجاٗ"},{"id":9,"text":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتاٗ"},{"id":10,"text":"وَجَعَلْنَا اَ۬ليْلَ لِبَاساٗ"},{"id":11,"text":"وَجَعَلْنَا اَ۬لنَّهَارَ مَعَاشاٗ"},{"id":12,"text":"وَبَنَيْنَا فَوْقَكُمْ سَبْعاٗ شِدَاداٗ"},{"id":13,"text":"وَجَعَلْنَا سِرَاجاٗ وَهَّاجاٗ"},{"id":14,"text":"وَأَنزَلْنَا مِنَ اَ۬لْمُعْصِرَٰتِ مَآءٗ ثَجَّاجاٗ"},{"id":15,"text":"لِّنُخْرِجَ بِهِۦ حَبّاٗ وَنَبَاتاٗ"},{"id":16,"text":"وَجَنَّٰتٍ اَلْفَافاًۖ"},{"id":17,"text":"اِنَّ يَوْمَ اَ۬لْفَصْلِ كَانَ مِيقَٰتاٗ"},{"id":18,"text":"يَوْمَ يُنفَخُ فِے اِ۬لصُّورِ فَتَاتُونَ أَفْوَاجاٗ"},{"id":19,"text":"وَفُتِّحَتِ اِ۬لسَّمَآءُ فَكَانَتَ اَبْوَٰباٗ"},{"id":20,"text":"وَسُيِّرَتِ اِ۬لْجِبَالُ فَكَانَتْ سَرَاباًۖ"},{"id":21,"text":"اِنَّ جَهَنَّمَ كَانَتْ مِرْصَاداٗ"},{"id":22,"text":"لِّلطَّٰغِينَ مَـَٔاباٗ"},{"id":23,"text":"لَّٰبِثِينَ فِيهَآ أَحْقَاباٗۖ"},{"id":24,"text":"لَّا يَذُوقُونَ فِيهَا بَرْداٗ وَلَا شَرَاباً"},{"id":25,"text":"اِلَّا حَمِيماٗ وَغَسَاقاٗ"},{"id":26,"text":"جَزَآءٗ وِفَاقاًۖ"},{"id":27,"text":"اِنَّهُمْ كَانُواْ لَا يَرْجُونَ حِسَاباٗ"},{"id":28,"text":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّاباٗۖ"},{"id":29,"text":"وَكُلَّ شَےْءٍ اَحْصَيْنَٰهُ كِتَٰباٗۖ"},{"id":30,"text":"فَذُوقُواْ فَلَن نَّزِيدَكُمُۥٓ إِلَّا عَذَاباًۖ"},{"id":31,"text":"اِنَّ لِلْمُتَّقِينَ مَفَازاً"},{"id":32,"text":"حَدَآئِقَ وَأَعْنَٰباٗ"},{"id":33,"text":"وَكَوَاعِبَ أَتْرَاباٗ"},{"id":34,"text":"وَكَأْساٗ دِهَاقاٗ"},{"id":35,"text":"لَّا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا كِذَّاباٗۖ"},{"id":36,"text":"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَاباٗۖ"},{"id":37,"text":"رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَاۖ اَ۬لرَّحْمَٰنُ لَا يَمْلِكُونَ مِنْهُ خِطَاباٗۖ"},{"id":38,"text":"يَوْمَ يَقُومُ اُ۬لرُّوحُ وَالْمَلَٰٓئِكَةُ صَفّاٗ لَّا يَتَكَلَّمُونَ إِلَّا مَنَ اَذِنَ لَهُ اُ۬لرَّحْمَٰنُ وَقَالَ صَوَاباٗۖ"},{"id":39,"text":"ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لْحَقُّۖ فَمَن شَآءَ اَ۪تَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔاباًۖ"},{"id":40,"text":"اِنَّآ أَنذَرْنَٰكُمْ عَذَاباٗ قَرِيباٗ يَوْمَ يَنظُرُ اُ۬لْمَرْءُ مَا قَدَّمَتْ يَدَٰهُ وَيَقُولُ اُ۬لْكَافِرُ يَٰلَيْتَنِے كُنتُ تُرَٰباٗۖ"}]