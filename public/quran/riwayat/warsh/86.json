[{"id":1,"text":"وَالسَّمَآءِ وَالطَّارِقِ"},{"id":2,"text":"وَمَآ أَدْر۪يٰكَ مَا اَ۬لطَّارِقُ"},{"id":3,"text":"اُ۬لنَّجْمُ اُ۬لثَّاقِبُ"},{"id":4,"text":"إِن كُلُّ نَفْسٖ لَّمَا عَلَيْهَا حَافِظٞۖ"},{"id":5,"text":"فَلْيَنظُرِ اِ۬لِانسَٰنُ مِمَّ خُلِقَۖ"},{"id":6,"text":"خُلِقَ مِن مَّآءٖ دَافِقٖ"},{"id":7,"text":"يَخْرُجُ مِنۢ بَيْنِ اِ۬لصُّلْبِ وَالتَّرَآئِبِۖ"},{"id":8,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٞ"},{"id":9,"text":"يَوْمَ تُبْلَى اَ۬لسَّرَآئِرُ"},{"id":10,"text":"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖۖ"},{"id":11,"text":"وَالسَّمَآءِ ذَاتِ اِ۬لرَّجْعِ"},{"id":12,"text":"وَالَارْضِ ذَاتِ اِ۬لصَّدْعِ"},{"id":13,"text":"إِنَّهُۥ لَقَوْلٞ فَصْلٞ"},{"id":14,"text":"وَمَا هُوَ بِالْهَزْلِۖ"},{"id":15,"text":"إِنَّهُمْ يَكِيدُونَ كَيْداٗ"},{"id":16,"text":"وَأَكِيدُ كَيْداٗۖ"},{"id":17,"text":"فَمَهِّلِ اِ۬لْكٰ۪فِرِينَ أَمْهِلْهُمْ رُوَيْداٗۖ"}]