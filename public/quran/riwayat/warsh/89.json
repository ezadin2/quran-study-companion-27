[{"id":1,"text":"وَالْفَجْرِ"},{"id":2,"text":"وَلَيَالٍ عَشْرٖ"},{"id":3,"text":"وَالشَّفْعِ وَالْوَتْرِ"},{"id":4,"text":"وَاليْلِ إِذَا يَسْرِۦ"},{"id":5,"text":"هَلْ فِے ذَٰلِكَ قَسَمٞ لِّذِے حِجْرٍۖ"},{"id":6,"text":"اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"},{"id":7,"text":"اِرَمَ ذَاتِ اِ۬لْعِمَادِ"},{"id":8,"text":"اِ۬لتِے لَمْ يُخْلَقْ مِثْلُهَا فِے اِ۬لْبِلَٰدِ"},{"id":9,"text":"وَثَمُودَ اَ۬لذِينَ جَابُواْ اُ۬لصَّخْرَ بِالْوَادِۦ"},{"id":10,"text":"وَفِرْعَوْنَ ذِے اِ۬لَاوْتَادِ"},{"id":11,"text":"اِ۬لذِينَ طَغَوْاْ فِے اِ۬لْبِلَٰدِ"},{"id":12,"text":"فَأَكْثَرُواْ فِيهَا اَ۬لْفَسَادَ"},{"id":13,"text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍۖ"},{"id":14,"text":"اِنَّ رَبَّكَ لَبِالْمِرْصَادِۖ"},{"id":15,"text":"فَأَمَّا اَ۬لِانسَٰنُ إِذَا مَا اَ۪بْتَل۪يٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ"},{"id":16,"text":"فَيَقُولُ رَبِّيَ أَكْرَمَنِۦۖ"},{"id":17,"text":"وَأَمَّآ إِذَا مَا اَ۪بْتَل۪يٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ"},{"id":18,"text":"فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ"},{"id":19,"text":"كَلَّاۖ بَل لَّا تُكْرِمُونَ اَ۬لْيَتِيمَ"},{"id":20,"text":"وَلَا تَحُضُّونَ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِ"},{"id":21,"text":"وَتَاكُلُونَ اَ۬لتُّرَاثَ أَكْلاٗ لَّمّاٗ"},{"id":22,"text":"وَتُحِبُّونَ اَ۬لْمَالَ حُبّاٗ جَمّاٗ"},{"id":23,"text":"كَلَّآۖ إِذَا دُكَّتِ اِ۬لَارْضُ دَكّاٗ دَكّاٗ"},{"id":24,"text":"وَجَآءَ رَبُّكَ وَالْمَلَكُ صَفّاٗ صَفّاٗ"},{"id":25,"text":"وَجِےٓءَ يَوْمَئِذِۢ بِجَهَنَّمَ"},{"id":26,"text":"يَوْمَئِذٖ يَتَذَكَّرُ اُ۬لِانسَٰنُ وَأَنّ۪ىٰ لَهُ اُ۬لذِّكْر۪ىٰۖ"},{"id":27,"text":"يَقُولُ يَٰلَيْتَنِے قَدَّمْتُ لِحَيَاتِےۖ"},{"id":28,"text":"فَيَوْمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ"},{"id":29,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞۖ"},{"id":30,"text":"يَٰٓأَيَّتُهَا اَ۬لنَّفْسُ اُ۬لْمُطْمَئِنَّةُ"},{"id":31,"text":"اُ۪رْجِعِےٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرْضِيَّةٗ"},{"id":32,"text":"فَادْخُلِے فِے عِبَٰدِے وَادْخُلِے جَنَّتِےۖ"}]