[{"id":1,"text":"وَالْعَٰدِيَٰتِ ضَبْحاٗ"},{"id":2,"text":"فَالْمُورِيَٰتِ قَدْحاٗ"},{"id":3,"text":"فَالْمُغِيرَٰتِ صُبْحاٗ"},{"id":4,"text":"فَأَثَرْنَ بِهِۦ نَقْعاٗ"},{"id":5,"text":"فَوَسَطْنَ بِهِۦ جَمْعاً"},{"id":6,"text":"اِنَّ اَ۬لِانسَٰنَ لِرَبِّهِۦ لَكَنُودٞ"},{"id":7,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ"},{"id":8,"text":"وَإِنَّهُۥ لِحُبِّ اِ۬لْخَيْرِ لَشَدِيدٌۖ"},{"id":9,"text":"۞ اَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِے اِ۬لْقُبُورِ"},{"id":10,"text":"وَحُصِّلَ مَا فِے اِ۬لصُّدُورِ"},{"id":11,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٖ لَّخَبِيرٌۖ"}]