[{"id":1,"text":"وَالْمُرْسَلَٰتِ عُرْفاٗ"},{"id":2,"text":"فَالْعَٰصِفَٰتِ عَصْفاٗ"},{"id":3,"text":"وَالنَّٰشِرَٰتِ نَشْراٗ"},{"id":4,"text":"فَالْفَٰرِقَٰتِ فَرْقاٗ"},{"id":5,"text":"فَالْمُلْقِيَٰتِ ذِكْراً"},{"id":6,"text":"عُذْراً اَوْ نُذُراً"},{"id":7,"text":"اِنَّمَا تُوعَدُونَ لَوَٰقِعٞۖ"},{"id":8,"text":"فَإِذَا اَ۬لنُّجُومُ طُمِسَتْ"},{"id":9,"text":"وَإِذَا اَ۬لسَّمَآءُ فُرِجَتْ"},{"id":10,"text":"وَإِذَا اَ۬لْجِبَالُ نُسِفَتْ"},{"id":11,"text":"وَإِذَا اَ۬لرُّسُلُ أُقِّتَتْ"},{"id":12,"text":"لِأَيِّ يَوْمٍ ا۟جِّلَتْ"},{"id":13,"text":"لِيَوْمِ اِ۬لْفَصْلِۖ"},{"id":14,"text":"وَمَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لْفَصْلِۖ"},{"id":15,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"id":16,"text":"۞ أَلَمْ نُهْلِكِ اِ۬لَاوَّلِينَۖ"},{"id":17,"text":"ثُمَّ نُتْبِعُهُمُ اُ۬لَاخِرِينَۖ"},{"id":18,"text":"كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ"},{"id":19,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"id":20,"text":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٖ مَّهِينٖ"},{"id":21,"text":"فَجَعَلْنَٰهُ فِے قَر۪ارٖ مَّكِينٍ"},{"id":22,"text":"اِلَىٰ قَدَرٖ مَّعْلُومٖ"},{"id":23,"text":"فَقَدَّرْنَاۖ فَنِعْمَ اَ۬لْقَٰدِرُونَۖ"},{"id":24,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"id":25,"text":"أَلَمْ نَجْعَلِ اِ۬لَارْضَ كِفَاتاً"},{"id":26,"text":"اَحْيَآءٗ وَأَمْوَٰتاٗ"},{"id":27,"text":"وَجَعَلْنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسْقَيْنَٰكُم مَّآءٗ فُرَاتاٗۖ"},{"id":28,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"id":29,"text":"اَ۪نطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"},{"id":30,"text":"اَ۪نطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِے ثَلَٰثِ شُعَبٖ"},{"id":31,"text":"لَّا ظَلِيلٖ وَلَا يُغْنِے مِنَ اَ۬للَّهَبِۖ"},{"id":32,"text":"إِنَّهَا تَرْمِے بِشَرَرٖ كَالْقَصْرِ"},{"id":33,"text":"كَأَنَّهُۥ جِمَٰلَٰتٞ صُفْرٞۖ"},{"id":34,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"id":35,"text":"هَٰذَا يَوْمُ لَا يَنطِقُونَ"},{"id":36,"text":"وَلَا يُوذَنُ لَهُمْ فَيَعْتَذِرُونَۖ"},{"id":37,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"id":38,"text":"هَٰذَا يَوْمُ اُ۬لْفَصْلِ جَمَعْنَٰكُمْ وَالَاوَّلِينَ"},{"id":39,"text":"فَإِن كَانَ لَكُمْ كَيْدٞ فَكِيدُونِۖ"},{"id":40,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"id":41,"text":"إِنَّ اَ۬لْمُتَّقِينَ فِے ظِلَٰلٖ وَعُيُونٖ"},{"id":42,"text":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَۖ"},{"id":43,"text":"كُلُواْ وَاشْرَبُواْۖ هَنِيٓـٔاَۢ بِمَا كُنتُمْ تَعْمَلُونَۖ"},{"id":44,"text":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ"},{"id":45,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"id":46,"text":"كُلُواْ وَتَمَتَّعُواْ قَلِيلاً اِنَّكُم مُّجْرِمُونَۖ"},{"id":47,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"id":48,"text":"وَإِذَا قِيلَ لَهُمُ اُ۪رْكَعُواْ لَا يَرْكَعُونَۖ"},{"id":49,"text":"وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ"},{"id":50,"text":"فَبِأَيِّ حَدِيثِۢ بَعْدَهُۥ يُومِنُونَۖ"}]