[{"id":1,"text":"وَاليْلِ إِذَا يَغْش۪ىٰ"},{"id":2,"text":"وَالنَّه۪ارِ إِذَا تَجَلّ۪ىٰ"},{"id":3,"text":"وَمَا خَلَقَ اَ۬لذَّكَرَ وَالُانث۪ىٰٓ"},{"id":4,"text":"إِنَّ سَعْيَكُمْ لَشَتّ۪ىٰۖ"},{"id":5,"text":"فَأَمَّا مَنَ اَعْط۪ىٰ وَاتَّق۪ىٰ"},{"id":6,"text":"وَصَدَّقَ بِالْحُسْن۪ىٰ"},{"id":7,"text":"فَسَنُيَسِّرُهُۥ لِلْيُسْر۪ىٰۖ"},{"id":8,"text":"وَأَمَّا مَنۢ بَخِلَ وَاسْتَغْن۪ىٰ"},{"id":9,"text":"وَكَذَّبَ بِالْحُسْن۪ىٰ"},{"id":10,"text":"فَسَنُيَسِّرُهُۥ لِلْعُسْر۪ىٰۖ"},{"id":11,"text":"وَمَا يُغْنِے عَنْهُ مَالُهُۥٓ إِذَا تَرَدّ۪ىٰٓۖ"},{"id":12,"text":"إِنَّ عَلَيْنَا لَلْهُد۪ىٰ"},{"id":13,"text":"وَإِنَّ لَنَا لَلَاخِرَةَ وَالُاول۪ىٰۖ"},{"id":14,"text":"فَأَنذَرْتُكُمْ نَاراٗ تَلَظّ۪ىٰ"},{"id":15,"text":"لَا يَصْلَيٰهَآ إِلَّا اَ۬لَاشْقَي"},{"id":16,"text":"اَ۬لذِے كَذَّبَ وَتَوَلّ۪ىٰۖ"},{"id":17,"text":"وَسَيُجَنَّبُهَا اَ۬لَاتْقَي"},{"id":18,"text":"اَ۬لذِے يُوتِے مَالَهُۥ يَتَزَكّ۪ىٰۖ"},{"id":19,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٖ تُجْز۪ىٰٓ"},{"id":20,"text":"إِلَّا اَ۪بْتِغَآءَ وَجْهِ رَبِّهِ اِ۬لَاعْل۪ىٰۖ"},{"id":21,"text":"وَلَسَوْفَ يَرْض۪ىٰۖ"}]