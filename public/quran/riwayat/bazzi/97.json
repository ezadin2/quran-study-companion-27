[{"id":1,"text":"إِنَّا أَنزَلۡنَٰهُۥ فِي لَيۡلَةِ ٱلۡقَدۡرِ"},{"id":2,"text":"وَمَا أَدۡرَىٰكَ مَا لَيۡلَةُ ٱلۡقَدۡرِ"},{"id":3,"text":"لَيۡلَةُ ٱلۡقَدۡرِ"},{"id":4,"text":"خَيۡرٞ مِّنۡ أَلۡفِ شَهۡرٖ"},{"id":5,"text":"تَّنَزَّلُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِمُۥ مِن كُلِّ أَمۡرٖ"},{"id":6,"text":"سَلَٰمٌ هِيَ حَتَّىٰ مَطۡلَعِ ٱلۡفَجۡرِ"}]