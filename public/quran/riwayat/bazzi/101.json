[{"id":1,"text":"ٱلۡقَارِعَةُ مَا ٱلۡقَارِعَةُ"},{"id":2,"text":"وَمَا أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ"},{"id":3,"text":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ"},{"id":4,"text":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ"},{"id":5,"text":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ"},{"id":6,"text":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ"},{"id":7,"text":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ"},{"id":8,"text":"فَأُمُّهُۥ هَاوِيَةٞ"},{"id":9,"text":"وَمَا أَدۡرَىٰكَ مَا هِيَهۡ"},{"id":10,"text":"نَارٌ حَامِيَةُۢ"}]