[{"id":1,"text":"عَمَّ يَتَسَآءَلُونَ"},{"id":2,"text":"عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ"},{"id":3,"text":"ٱلَّذِي هُمُۥ فِيهِۦ مُخۡتَلِفُونَ"},{"id":4,"text":"كَلَّا سَيَعۡلَمُونَ"},{"id":5,"text":"ثُمَّ كَلَّا سَيَعۡلَمُونَ"},{"id":6,"text":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا"},{"id":7,"text":"وَٱلۡجِبَالَ أَوۡتَادٗا"},{"id":8,"text":"وَخَلَقۡنَٰكُمُۥ أَزۡوَٰجٗا"},{"id":9,"text":"وَجَعَلۡنَا نَوۡمَكُمُۥ سُبَاتٗا"},{"id":10,"text":"وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا"},{"id":11,"text":"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا"},{"id":12,"text":"وَبَنَيۡنَا فَوۡقَكُمُۥ سَبۡعٗا شِدَادٗا"},{"id":13,"text":"وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا"},{"id":14,"text":"وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا"},{"id":15,"text":"لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا"},{"id":16,"text":"وَجَنَّٰتٍ أَلۡفَافًا"},{"id":17,"text":"إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا"},{"id":18,"text":"يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا"},{"id":19,"text":"وَفُتِّحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا"},{"id":20,"text":"وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا"},{"id":21,"text":"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا"},{"id":22,"text":"لِّلطَّٰغِينَ مَـَٔابٗا"},{"id":23,"text":"لَّٰبِثِينَ فِيهَا أَحۡقَابٗا"},{"id":24,"text":"لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا"},{"id":25,"text":"إِلَّا حَمِيمٗا وَغَسَاقٗا"},{"id":26,"text":"جَزَآءٗ وِفَاقًا"},{"id":27,"text":"إِنَّهُمُۥ كَانُواْ لَا يَرۡجُونَ حِسَابٗا"},{"id":28,"text":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا"},{"id":29,"text":"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُۥ كِتَٰبٗا"},{"id":30,"text":"فَذُوقُواْ فَلَن نَّزِيدَكُمُۥ إِلَّا عَذَابًا"},{"id":31,"text":"إِنَّ لِلۡمُتَّقِينَ مَفَازًا"},{"id":32,"text":"حَدَآئِقَ وَأَعۡنَٰبٗا"},{"id":33,"text":"وَكَوَاعِبَ أَتۡرَابٗا"},{"id":34,"text":"وَكَأۡسٗا دِهَاقٗا"},{"id":35,"text":"لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّٰبٗا"},{"id":36,"text":"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا"},{"id":37,"text":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنُۖ لَا يَمۡلِكُونَ مِنۡهُۥ خِطَابٗا"},{"id":38,"text":"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا"},{"id":39,"text":"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا"},{"id":40,"text":"إِنَّا أَنذَرۡنَٰكُمُۥ عَذَابٗا قَرِيبٗا"},{"id":41,"text":"يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُۥ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا"}]