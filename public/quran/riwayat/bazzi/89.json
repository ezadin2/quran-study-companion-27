[{"id":1,"text":"وَٱلۡفَجۡرِ"},{"id":2,"text":"وَلَيَالٍ عَشۡرٖ"},{"id":3,"text":"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ"},{"id":4,"text":"وَٱلَّيۡلِ إِذَا يَسۡرِۦ"},{"id":5,"text":"هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ"},{"id":6,"text":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ"},{"id":7,"text":"إِرَمَ ذَاتِ ٱلۡعِمَادِ"},{"id":8,"text":"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ"},{"id":9,"text":"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِۦ"},{"id":10,"text":"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ"},{"id":11,"text":"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ"},{"id":12,"text":"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ"},{"id":13,"text":"فَصَبَّ عَلَيۡهِمُۥ رَبُّكَ سَوۡطَ عَذَابٍ"},{"id":14,"text":"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ"},{"id":15,"text":"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُۥ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ"},{"id":16,"text":"فَيَقُولُ رَبِّيَ أَكۡرَمَنِۦ"},{"id":17,"text":"وَأَمَّا إِذَا مَا ٱبۡتَلَىٰهُۥ فَقَدَرَ عَلَيۡهِۦ رِزۡقَهُۥ"},{"id":18,"text":"فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ"},{"id":19,"text":"كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ"},{"id":20,"text":"وَلَا تَحُضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ"},{"id":21,"text":"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا"},{"id":22,"text":"وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا"},{"id":23,"text":"كَلَّاۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا"},{"id":24,"text":"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا"},{"id":25,"text":"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَ"},{"id":26,"text":"يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ"},{"id":27,"text":"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي"},{"id":28,"text":"فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥ أَحَدٞ"},{"id":29,"text":"وَلَا يُوثِقُ وَثَاقَهُۥ أَحَدٞ"},{"id":30,"text":"يَٰأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ"},{"id":31,"text":"ٱرۡجِعِي إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ"},{"id":32,"text":"فَٱدۡخُلِي فِي عِبَٰدِي وَٱدۡخُلِي جَنَّتِي"}]