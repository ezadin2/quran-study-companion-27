[{"id":1,"text":"إِذَا زُلْزِلَتِ اِ۬لْأَرْضُ زِلْزَالَهَا"},{"id":2,"text":"وَأَخْرَجَتِ اِ۬لْأَرْضُ أَثْقَالَهَا"},{"id":3,"text":"وَقَالَ اَ۬لْإِنسَٰنُ مَا لَهَا"},{"id":4,"text":"يَوْمَئِذٖ تُحَدِّثُ أَخْبَارَهَا"},{"id":5,"text":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَاۖ"},{"id":6,"text":"يَوْمَئِذٖ يَصْدُرُ اُ۬لنَّاسُ أَشْتَاتاٗ"},{"id":7,"text":"لِّيُرَوْاْ أَعْمَٰلَهُمْۖ"},{"id":8,"text":"فَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْراٗ يَرَهُۥۖ"},{"id":9,"text":"وَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٖ شَرّاٗ يَرَهُۥۖ"}]