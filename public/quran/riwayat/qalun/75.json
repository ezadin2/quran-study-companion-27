[{"id":1,"text":"لَا أُقْسِمُ بِيَوْمِ اِ۬لْقِيَٰمَةِ"},{"id":2,"text":"وَلَا أُقْسِمُ بِالنَّفْسِ اِ۬للَّوَّامَةِۖ"},{"id":3,"text":"أَيَحْسِبُ اُ۬لْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"},{"id":4,"text":"بَلَىٰۖ قَٰدِرِينَ عَلَىٰ أَن نُّسَوِّيَ بَنَانَهُۥۖ"},{"id":5,"text":"بَلْ يُرِيدُ اُ۬لْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥۖ"},{"id":6,"text":"يَسْـَٔلُ أَيَّانَ يَوْمُ اُ۬لْقِيَٰمَةِۖ"},{"id":7,"text":"فَإِذَا بَرَقَ اَ۬لْبَصَرُ"},{"id":8,"text":"وَخَسَفَ اَ۬لْقَمَرُ"},{"id":9,"text":"وَجُمِعَ اَ۬لشَّمْسُ وَالْقَمَرُ"},{"id":10,"text":"يَقُولُ اُ۬لْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ اَ۬لْمَفَرُّۖ"},{"id":11,"text":"كَلَّا لَا وَزَرَۖ"},{"id":12,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمُسْتَقَرُّۖ"},{"id":13,"text":"يُنَبَّؤُاْ اُ۬لْإِنسَٰنُ يَوْمَئِذِۢ بِمَا قَدَّمَ وَأَخَّرَۖ"},{"id":14,"text":"بَلِ اِ۬لْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٞ"},{"id":15,"text":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥۖ"},{"id":16,"text":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦۖ إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥۖ"},{"id":17,"text":"فَإِذَا قَرَأْنَٰهُ فَاتَّبِعْ قُرْءَانَهُۥ"},{"id":18,"text":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥۖ"},{"id":19,"text":"كَلَّا بَلْ تُحِبُّونَ اَ۬لْعَاجِلَةَ"},{"id":20,"text":"وَتَذَرُونَ اَ۬لْأٓخِرَةَۖ"},{"id":21,"text":"وُجُوهٞ يَوْمَئِذٖ نَّاضِرَةٌ"},{"id":22,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٞۖ"},{"id":23,"text":"وَوُجُوهٞ يَوْمَئِذِۢ بَاسِرَةٞ"},{"id":24,"text":"تَظُنُّ أَنْ يُّفْعَلَ بِهَا فَاقِرَةٞۖ"},{"id":25,"text":"كَلَّا إِذَا بَلَغَتِ اِ۬لتَّرَاقِيَ"},{"id":26,"text":"وَقِيلَ مَن رَّاقٖ"},{"id":27,"text":"وَظَنَّ أَنَّهُ اُ۬لْفِرَاقُ"},{"id":28,"text":"وَالْتَفَّتِ اِ۬لسَّاقُ بِالسَّاقِ"},{"id":29,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمَسَاقُۖ"},{"id":30,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰۖ"},{"id":31,"text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰۖ"},{"id":32,"text":"ثُمَّ ذَهَبَ إِلَىٰ أَهْلِهِۦ يَتَمَطَّىٰۖ"},{"id":33,"text":"أَوْلَىٰ لَكَ فَأَوْلَىٰ"},{"id":34,"text":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰۖ"},{"id":35,"text":"أَيَحْسِبُ اُ۬لْإِنسَٰنُ أَنْ يُّتْرَكَ سُدىًۖ"},{"id":36,"text":"أَلَمْ يَكُ نُطْفَةٗ مِّن مَّنِيّٖ تُمْنَىٰ"},{"id":37,"text":"ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ"},{"id":38,"text":"فَجَعَلَ مِنْهُ اُ۬لزَّوْجَيْنِ اِ۬لذَّكَرَ وَالْأُنثَىٰۖ"},{"id":39,"text":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰ أَنْ يُّحْـِۧيَ اَ۬لْمَوْتَىٰۖ"}]