[{"id":1,"text":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ"},{"id":2,"text":"وَوَضَعْنَا عَنكَ وِزْرَكَ"},{"id":3,"text":"اَ۬لذِے أَنقَضَ ظَهْرَكَ"},{"id":4,"text":"وَرَفَعْنَا لَكَ ذِكْرَكَۖ"},{"id":5,"text":"فَإِنَّ مَعَ اَ۬لْعُسْرِ يُسْراً"},{"id":6,"text":"إِنَّ مَعَ اَ۬لْعُسْرِ يُسْراٗۖ"},{"id":7,"text":"فَإِذَا فَرَغْتَ فَانصَبْ"},{"id":8,"text":"وَإِلَىٰ رَبِّكَ فَارْغَبۖ"}]