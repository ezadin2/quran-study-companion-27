[{"id":1,"text":"عَبَسَ وَتَوَلَّىٰ"},{"id":2,"text":"أَن جَآءَهُ اُ۬لْأَعْمَىٰۖ"},{"id":3,"text":"وَمَا يُدْرِيكَۖ لَعَلَّهُۥ يَزَّكَّىٰ"},{"id":4,"text":"أَوْ يَذَّكَّرُ فَتَنفَعُهُ اُ۬لذِّكْرَىٰۖ"},{"id":5,"text":"أَمَّا مَنِ اِ۪سْتَغْنَىٰ"},{"id":6,"text":"فَأَنتَ لَهُۥ تَصَّدَّىٰ"},{"id":7,"text":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰۖ"},{"id":8,"text":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ"},{"id":9,"text":"وَهْوَ يَخْشَىٰ"},{"id":10,"text":"فَأَنتَ عَنْهُ تَلَهَّىٰ"},{"id":11,"text":"كَلَّاۖ إِنَّهَا تَذْكِرَةٞۖ"},{"id":12,"text":"فَمَن شَآءَ ذَكَرَهُۥ"},{"id":13,"text":"فِے صُحُفٖ مُّكَرَّمَةٖ"},{"id":14,"text":"مَّرْفُوعَةٖ مُّطَهَّرَةِۢ"},{"id":15,"text":"بِأَيْدِے سَفَرَةٖ"},{"id":16,"text":"كِرَامِۢ بَرَرَةٖۖ"},{"id":17,"text":"قُتِلَ اَ۬لْإِنسَٰنُ مَا أَكْفَرَهُۥۖ"},{"id":18,"text":"مِنْ أَيِّ شَےْءٍ خَلَقَهُۥۖ"},{"id":19,"text":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"},{"id":20,"text":"ثُمَّ اَ۬لسَّبِيلَ يَسَّرَهُۥ"},{"id":21,"text":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥۖ"},{"id":22,"text":"ثُمَّ إِذَا شَا أَنشَرَهُۥۖ"},{"id":23,"text":"كَلَّا لَمَّا يَقْضِ مَا أَمَرَهُۥۖ"},{"id":24,"text":"فَلْيَنظُرِ اِ۬لْإِنسَٰنُ إِلَىٰ طَعَامِهِۦۖ"},{"id":25,"text":"إِنَّا صَبَبْنَا اَ۬لْمَآءَ صَبّاٗ"},{"id":26,"text":"ثُمَّ شَقَقْنَا اَ۬لْأَرْضَ شَقّاٗ"},{"id":27,"text":"فَأَنۢبَتْنَا فِيهَا حَبّاٗ"},{"id":28,"text":"وَعِنَباٗ وَقَضْباٗ"},{"id":29,"text":"وَزَيْتُوناٗ وَنَخْلاٗ"},{"id":30,"text":"وَحَدَآئِقَ غُلْباٗ"},{"id":31,"text":"وَفَٰكِهَةٗ وَأَبّاٗ"},{"id":32,"text":"مَّتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ"},{"id":33,"text":"فَإِذَا جَآءَتِ اِ۬لصَّآخَّةُ"},{"id":34,"text":"يَوْمَ يَفِرُّ اُ۬لْمَرْءُ مِنْ أَخِيهِ"},{"id":35,"text":"وَأُمِّهِۦ وَأَبِيهِ"},{"id":36,"text":"وَصَٰحِبَتِهِۦ وَبَنِيهِۖ"},{"id":37,"text":"لِكُلِّ اِ۪مْرِےٕٖ مِّنْهُمْ يَوْمَئِذٖ شَأْنٞ يُغْنِيهِۖ"},{"id":38,"text":"وُجُوهٞ يَوْمَئِذٖ مُّسْفِرَةٞ"},{"id":39,"text":"ضَاحِكَةٞ مُّسْتَبْشِرَةٞۖ"},{"id":40,"text":"وَوُجُوهٞ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٞ"},{"id":41,"text":"تَرْهَقُهَا قَتَرَةٌۖ"},{"id":42,"text":"أُوْلَٰٓئِكَ هُمُ اُ۬لْكَفَرَةُ اُ۬لْفَجَرَةُۖ"}]