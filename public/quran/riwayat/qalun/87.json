[{"id":1,"text":"سَبِّحِ اِ۪سْمَ رَبِّكَ اَ۬لْأَعْلَى"},{"id":2,"text":"اَ۬لذِے خَلَقَ فَسَوَّىٰ"},{"id":3,"text":"وَالذِے قَدَّرَ فَهَدَىٰ"},{"id":4,"text":"وَالذِے أَخْرَجَ اَ۬لْمَرْعَىٰ"},{"id":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰۖ"},{"id":6,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰ"},{"id":7,"text":"إِلَّا مَا شَآءَ اَ۬للَّهُۖ إِنَّهُۥ يَعْلَمُ اُ۬لْجَهْرَ وَمَا يَخْفَىٰۖ"},{"id":8,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰۖ"},{"id":9,"text":"فَذَكِّرْ إِن نَّفَعَتِ اِ۬لذِّكْرَىٰۖ"},{"id":10,"text":"سَيَذَّكَّرُ مَنْ يَّخْشَىٰ"},{"id":11,"text":"وَيَتَجَنَّبُهَا اَ۬لْأَشْقَى"},{"id":12,"text":"اَ۬لذِے يَصْلَى اَ۬لنَّارَ اَ۬لْكُبْرَىٰ"},{"id":13,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰۖ"},{"id":14,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ"},{"id":15,"text":"وَذَكَرَ اَ۪سْمَ رَبِّهِۦ فَصَلَّىٰۖ"},{"id":16,"text":"بَلْ تُؤْثِرُونَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْيَا"},{"id":17,"text":"وَالْأٓخِرَةُ خَيْرٞ وَأَبْقَىٰۖ"},{"id":18,"text":"إِنَّ هَٰذَا لَفِے اِ۬لصُّحُفِ اِ۬لْأُولَىٰ"},{"id":19,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰۖ"}]