[{"id":1,"text":"أَرَٰ۬يْتَ اَ۬لذِے يُكَذِّبُ بِالدِّينِ"},{"id":2,"text":"فَذَٰلِكَ اَ۬لذِے يَدُعُّ اُ۬لْيَتِيمَ"},{"id":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ"},{"id":4,"text":"فَوَيْلٞ لِّلْمُصَلِّينَ"},{"id":5,"text":"اَ۬لذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"},{"id":6,"text":"اَ۬لذِينَ هُمْ يُرَآءُونَ وَيَمْنَعُونَ اَ۬لْمَاعُونَۖ"}]