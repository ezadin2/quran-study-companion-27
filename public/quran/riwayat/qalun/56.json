[{"id":1,"text":"إِذَا وَقَعَتِ اِ۬لْوَاقِعَةُ"},{"id":2,"text":"لَيْسَ لِوَقْعَتِهَا كَٰذِبَةٌۖ"},{"id":3,"text":"خَافِضَةٞ رَّافِعَةٌ"},{"id":4,"text":"إِذَا رُجَّتِ اِ۬لْأَرْضُ رَجّاٗ"},{"id":5,"text":"وَبُسَّتِ اِ۬لْجِبَالُ بَسّاٗ"},{"id":6,"text":"فَكَانَتْ هَبَآءٗ مُّنۢبَثّاٗ"},{"id":7,"text":"وَكُنتُمْ أَزْوَٰجاٗ ثَلَٰثَةٗۖ"},{"id":8,"text":"فَأَصْحَٰبُ اُ۬لْمَيْمَنَةِ"},{"id":9,"text":"مَا أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ"},{"id":10,"text":"وَأَصْحَٰبُ اُ۬لْمَشْـَٔمَةِ"},{"id":11,"text":"مَا أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ"},{"id":12,"text":"وَالسَّٰبِقُونَ اَ۬لسَّٰبِقُونَۖ"},{"id":13,"text":"أُوْلَٰٓئِكَ اَ۬لْمُقَرَّبُونَ"},{"id":14,"text":"فِے جَنَّٰتِ اِ۬لنَّعِيمِۖ"},{"id":15,"text":"ثُلَّةٞ مِّنَ اَ۬لْأَوَّلِينَ"},{"id":16,"text":"وَقَلِيلٞ مِّنَ اَ۬لْأٓخِرِينَ"},{"id":17,"text":"عَلَىٰ سُرُرٖ مَّوْضُونَةٖ"},{"id":18,"text":"مُّتَّكِـِٕينَ عَلَيْهَا مُتَقَٰبِلِينَۖ"},{"id":19,"text":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٞ مُّخَلَّدُونَ"},{"id":20,"text":"بِأَكْوَابٖ وَأَبَارِيقَ"},{"id":21,"text":"وَكَأْسٖ مِّن مَّعِينٖ"},{"id":22,"text":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزَفُونَ"},{"id":23,"text":"وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ"},{"id":24,"text":"وَلَحْمِ طَيْرٖ مِّمَّا يَشْتَهُونَۖ"},{"id":25,"text":"وَحُورٌ عِينٞ كَأَمْثَٰلِ اِ۬للُّؤْلُوِٕ اِ۬لْمَكْنُونِ"},{"id":26,"text":"جَزَآءَۢ بِمَا كَانُواْ يَعْمَلُونَۖ"},{"id":27,"text":"لَا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا تَأْثِيماًۖ"},{"id":28,"text":"إِلَّا قِيلاٗ سَلَٰماٗ سَلَٰماٗۖ"},{"id":29,"text":"وَأَصْحَٰبُ اُ۬لْيَمِينِ مَا أَصْحَٰبُ اُ۬لْيَمِينِۖ"},{"id":30,"text":"فِے سِدْرٖ مَّخْضُودٖ"},{"id":31,"text":"وَطَلْحٖ مَّنضُودٖ"},{"id":32,"text":"وَظِلّٖ مَّمْدُودٖ"},{"id":33,"text":"وَمَآءٖ مَّسْكُوبٖ"},{"id":34,"text":"وَفَٰكِهَةٖ كَثِيرَةٖ"},{"id":35,"text":"لَّا مَقْطُوعَةٖ وَلَا مَمْنُوعَةٖ"},{"id":36,"text":"وَفُرُشٖ مَّرْفُوعَةٍۖ"},{"id":37,"text":"إِنَّا أَنشَأْنَٰهُنَّ إِنشَآءٗ"},{"id":38,"text":"فَجَعَلْنَٰهُنَّ أَبْكَاراً"},{"id":39,"text":"عُرُباً أَتْرَاباٗ"},{"id":40,"text":"لِّأَصْحَٰبِ اِ۬لْيَمِينِۖ"},{"id":41,"text":"ثُلَّةٞ مِّنَ اَ۬لْأَوَّلِينَ"},{"id":42,"text":"وَثُلَّةٞ مِّنَ اَ۬لْأٓخِرِينَۖ"},{"id":43,"text":"وَأَصْحَٰبُ اُ۬لشِّمَالِ"},{"id":44,"text":"مَا أَصْحَٰبُ اُ۬لشِّمَالِۖ"},{"id":45,"text":"فِے سَمُومٖ وَحَمِيمٖ"},{"id":46,"text":"وَظِلّٖ مِّنْ يَّحْمُومٖ"},{"id":47,"text":"لَّا بَارِدٖ وَلَا كَرِيمٍۖ"},{"id":48,"text":"إِنَّهُمْ كَانُواْ قَبْلَ ذَٰلِكَ مُتْرَفِينَۖ"},{"id":49,"text":"وَكَانُواْ يُصِرُّونَ عَلَى اَ۬لْحِنثِ اِ۬لْعَظِيمِۖ"},{"id":50,"text":"وَكَانُواْ يَقُولُونَ أَٰئِذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً إِنَّا لَمَبْعُوثُونَ"},{"id":51,"text":"أَوْ ءَابَآؤُنَا اَ۬لْأَوَّلُونَۖ"},{"id":52,"text":"۞ قُلْ إِنَّ اَ۬لْأَوَّلِينَ وَالْأٓخِرِينَ لَمَجْمُوعُونَ"},{"id":53,"text":"إِلَىٰ مِيقَٰتِ يَوْمٖ مَّعْلُومٖۖ"},{"id":54,"text":"ثُمَّ إِنَّكُمْ أَيُّهَا اَ۬لضَّآلُّونَ اَ۬لْمُكَذِّبُونَ"},{"id":55,"text":"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ"},{"id":56,"text":"فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ"},{"id":57,"text":"فَشَٰرِبُونَ عَلَيْهِ مِنَ اَ۬لْحَمِيمِ"},{"id":58,"text":"فَشَٰرِبُونَ شُرْبَ اَ۬لْهِيمِۖ"},{"id":59,"text":"هَٰذَا نُزُلُهُمْ يَوْمَ اَ۬لدِّينِۖ"},{"id":60,"text":"نَحْنُ خَلَقْنَٰكُمْۖ فَلَوْلَا تُصَدِّقُونَۖ"},{"id":61,"text":"أَفَرَٰ۬يْتُم مَّا تُمْنُونَ"},{"id":62,"text":"ءَٰا۬نتُمْ تَخْلُقُونَهُۥ أَمْ نَحْنُ اُ۬لْخَٰلِقُونَۖ"},{"id":63,"text":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ اُ۬لْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ"},{"id":64,"text":"عَلَىٰ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِے مَا لَا تَعْلَمُونَۖ"},{"id":65,"text":"وَلَقَدْ عَلِمْتُمُ اُ۬لنَّشْأَةَ اَ۬لْأُولَىٰۖ فَلَوْلَا تَذَّكَّرُونَۖ"},{"id":66,"text":"أَفَرَٰ۬يْتُم مَّا تَحْرُثُونَ"},{"id":67,"text":"ءَٰا۬نتُمْ تَزْرَعُونَهُۥ أَمْ نَحْنُ اُ۬لزَّٰرِعُونَۖ"},{"id":68,"text":"لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰماٗ فَظَلْتُمْ تَفَكَّهُونَ"},{"id":69,"text":"إِنَّا لَمُغْرَمُونَ"},{"id":70,"text":"بَلْ نَحْنُ مَحْرُومُونَۖ"},{"id":71,"text":"أَفَرَٰ۬يْتُمُ اُ۬لْمَآءَ اَ۬لذِے تَشْرَبُونَ"},{"id":72,"text":"ءَٰا۬نتُمْ أَنزَلْتُمُوهُ مِنَ اَ۬لْمُزْنِ أَمْ نَحْنُ اُ۬لْمُنزِلُونَۖ"},{"id":73,"text":"لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجاٗۖ فَلَوْلَا تَشْكُرُونَۖ"},{"id":74,"text":"أَفَرَٰ۬يْتُمُ اُ۬لنَّارَ اَ۬لتِے تُورُونَ"},{"id":75,"text":"ءَٰا۬نتُمْ أَنشَأْتُمْ شَجَرَتَهَا أَمْ نَحْنُ اُ۬لْمُنشِـُٔونَۖ"},{"id":76,"text":"نَحْنُ جَعَلْنَٰهَا تَذْكِرَةٗ وَمَتَٰعاٗ لِّلْمُقْوِينَۖ"},{"id":77,"text":"فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ"},{"id":78,"text":"۞ فَلَا أُقْسِمُ بِمَوَٰقِعِ اِ۬لنُّجُومِ"},{"id":79,"text":"وَإِنَّهُۥ لَقَسَمٞ لَّوْ تَعْلَمُونَ عَظِيمٌ"},{"id":80,"text":"إِنَّهُۥ لَقُرْءَانٞ كَرِيمٞ"},{"id":81,"text":"فِے كِتَٰبٖ مَّكْنُونٖ"},{"id":82,"text":"لَّا يَمَسُّهُۥ إِلَّا اَ۬لْمُطَهَّرُونَۖ"},{"id":83,"text":"تَنزِيلٞ مِّن رَّبِّ اِ۬لْعَٰلَمِينَۖ"},{"id":84,"text":"أَفَبِهَٰذَا اَ۬لْحَدِيثِ أَنتُم مُّدْهِنُونَ"},{"id":85,"text":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَۖ"},{"id":86,"text":"فَلَوْلَا إِذَا بَلَغَتِ اِ۬لْحُلْقُومَ"},{"id":87,"text":"وَأَنتُمْ حِينَئِذٖ تَنظُرُونَ"},{"id":88,"text":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ"},{"id":89,"text":"فَلَوْلَا إِن كُنتُمْ غَيْرَ مَدِينِينَ"},{"id":90,"text":"تَرْجِعُونَهَا إِن كُنتُمْ صَٰدِقِينَۖ"},{"id":91,"text":"فَأَمَّا إِن كَانَ مِنَ اَ۬لْمُقَرَّبِينَ"},{"id":92,"text":"فَرَوْحٞ وَرَيْحَانٞ وَجَنَّتُ نَعِيمٖۖ"},{"id":93,"text":"وَأَمَّا إِن كَانَ مِنْ أَصْحَٰبِ اِ۬لْيَمِينِ"},{"id":94,"text":"فَسَلَٰمٞ لَّكَ مِنْ أَصْحَٰبِ اِ۬لْيَمِينِۖ"},{"id":95,"text":"وَأَمَّا إِن كَانَ مِنَ اَ۬لْمُكَذِّبِينَ اَ۬لضَّآلِّينَ"},{"id":96,"text":"فَنُزُلٞ مِّنْ حَمِيمٖ"},{"id":97,"text":"وَتَصْلِيَةُ جَحِيمٍۖ"},{"id":98,"text":"إِنَّ هَٰذَا لَهْوَ حَقُّ اُ۬لْيَقِينِۖ"},{"id":99,"text":"فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ"}]